      "payload": { "door_id": "string", "flow": "open_dimension | join_near_friend | join_new_location", "character_id": "char_* id", "class_id": "class_* id", "deck_commitment": "hash of the shuffled deck order (rule_0_setup, rule_10)", "entry_tile": { "x": "int", "y": "int" }, "adopted_head": "hashgraph head the peer synced from" } } } ] },

    { "id": "evt_leave", "name": "Leave", "tags": ["lifecycle"], "versions": [ { "version": "1.0.0", "weight": 1.0, "status": "canonical", "origin": "paper_rules", "author_peer_id": "", "created_at": "2026-10-19", "parent_version": null, "rebalance_links": ["action_travel_door"], "vote_log": [], "notes": "", "data": {
