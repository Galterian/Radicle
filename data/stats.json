{
  "collection": "stats",
  "entries": [
    {
      "id": "stat_vitality",
      "name": "Vitality",
      "tags": [
        "pillar",
        "physical"
      ],
      "versions": [
        {
          "version": "1.0.0",
          "weight": 1.0,
          "status": "canonical",
          "origin": "paper_rules",
          "author_peer_id": "",
          "created_at": "2026-10-19",
          "parent_version": null,
          "rebalance_links": [
            "stat_world",
            "stat_matter",
            "stat_will"
          ],
          "vote_log": [],
          "notes": "",
          "data": {
            "code": "V",
            "pillar_role": "physical",
            "zero_in": [
              "undead",
              "astral"
            ],
            "elements": [
              "elem_vitality"
            ]
          },
          "logic": {
            "description": "Vitality (code V) is the physical pillar. It powers one element, elem_vitality: a caster emits Vitality with power stats.vitality and resists it with the same stat (Rule 18); its point-buy rolls point_buy_dice_count(vitality) dice (Rule 20); Force Shield's Vitality die is the shield value (pc). zero_in: undead and astral beings have Vitality 0 (species rule). Vitality counts fully in the stat sum that gives life (Rule 14).",
            "prerequisites": [
              {
                "id": "unit-has-vitality",
                "description": "The caster's stats carry a numeric vitality.",
                "when": {
                  "==": [
                    {
                      "typeof": [
                        {
                          "var": "caster.stats.vitality"
                        }
                      ]
                    },
                    "number"
                  ]
                }
              }
            ],
            "effects": [
              {
                "id": "elements",
                "description": "Elements this stat powers.",
                "target": "caster",
                "value": {
                  "var": "entry.data.elements"
                }
              },
              {
                "id": "emit-power",
                "description": "Emission power for any Vitality element.",
                "target": "caster",
                "unit": "stat",
                "value": {
                  "var": "caster.stats.vitality"
                }
              },
              {
                "id": "point-buy-dice",
                "description": "Dice a Vitality point-buy rolls.",
                "target": "caster",
                "unit": "die",
                "value": {
                  "rule": [
                    "point_buy_dice_count",
                    {
                      "stat": {
                        "var": "caster.stats.vitality"
                      }
                    }
                  ]
                }
              },
              {
                "id": "zero-in",
                "description": "Kinds of being with this stat at 0.",
                "target": "caster",
                "value": {
                  "var": "entry.data.zero_in"
                }
              }
            ],
            "validation": [
              {
                "id": "code-unchanged",
                "description": "The stat code never changes.",
                "assert": {
                  "==": [
                    {
                      "var": "proposal.data.code"
                    },
                    {
                      "var": "entry.data.code"
                    }
                  ]
                }
              },
              {
                "id": "pillar-role-unchanged",
                "description": "The pillar role never changes.",
                "assert": {
                  "==": [
                    {
                      "var": "proposal.data.pillar_role"
                    },
                    {
                      "var": "entry.data.pillar_role"
                    }
                  ]
                }
              },
              {
                "id": "elements-valid",
                "description": "elements is a non-empty subset of the ten element ids.",
                "assert": {
                  "and": [
                    {
                      ">=": [
                        {
                          "count": [
                            {
                              "var": "proposal.data.elements"
                            }
                          ]
                        },
                        1
                      ]
                    },
                    {
                      "subset_of": [
                        {
                          "var": "proposal.data.elements"
                        },
                        {
                          "rule": [
                            "valid_element_ids",
                            {}
                          ]
                        }
                      ]
                    },
                    {
                      "distinct": [
                        {
                          "var": "proposal.data.elements"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "id": "elements-map-back",
                "description": "Every listed element's own stat column names this stat.",
                "assert": {
                  "all": [
                    {
                      "var": "proposal.data.elements"
                    },
                    {
                      "==": [
                        {
                          "entry": [
                            {
                              "var": ""
                            },
                            "stat"
                          ]
                        },
                        {
                          "root": "entry.id"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "id": "zero-in-unchanged",
                "description": "zero_in keeps the same set of kinds.",
                "assert": {
                  "and": [
                    {
                      "subset_of": [
                        {
                          "var": "proposal.data.zero_in"
                        },
                        {
                          "var": "entry.data.zero_in"
                        }
                      ]
                    },
                    {
                      "subset_of": [
                        {
                          "var": "entry.data.zero_in"
                        },
                        {
                          "var": "proposal.data.zero_in"
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "references": [
              "point_buy_dice_count",
              "valid_element_ids"
            ]
          }
        }
      ]
    },
