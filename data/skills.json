{
  "collection": "skills",
  "notes": "Skills are played as instants attached to a matching action card. Point-buy skills roll against the listed stat.",
  "entries": [
    { "id": "skill_powerful_attack",   "name": "Powerful attack",       "tags": ["attack"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_overrun","skill_grapple","skill_ranged_weapon"],"vote_log":[],"notes":"","data":{ "action_type":"A", "is_permanent":false, "point_buy_stat":null, "text":"On successful attack: +1 damage; cannot perform any other action except Attack until end of round." }}] },
    { "id": "skill_overrun",           "name": "Overrun / Push",        "tags": ["attack","move"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_powerful_attack"],"vote_log":[],"notes":"","data":{ "action_type":"A", "is_permanent":false, "point_buy_stat":null, "text":"Swap places with the enemy (walk over them and go behind). Negate enemy's Move. Alt: the enemy or ally is moved one tile away; step over them." }}] },
    { "id": "skill_grapple",           "name": "Grapple",               "tags": ["attack","lock"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_intimidation"],"vote_log":[],"notes":"","data":{ "action_type":"A", "is_permanent":false, "point_buy_stat":null, "text":"Negate enemy's Posture or Empty Posture (enemy may replace with another action; Empty Move is still possible). While sharing a tile, neither may use Posture or Empty Posture." }}] },
    { "id": "skill_ranged_weapon",     "name": "Ranged weapon",         "tags": ["attack","permanent","range"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_disruption_move"],"vote_log":[],"notes":"","data":{ "action_type":"A", "is_permanent":true, "point_buy_stat":"stat_matter", "element":"elem_fire", "text":"Permanent. On your Attack action, enemy's Block action does not cause you combat damage. Your Attack action does not trigger traps and the follow rule is not applied." }}] },

    { "id": "skill_taunt",             "name": "Taunt",                 "tags": ["block","permanent"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_barricade"],"vote_log":[],"notes":"","data":{ "action_type":"B", "is_permanent":true, "point_buy_stat":"stat_vitality", "text":"Nearby enemies cannot Attack anything besides you. Nearby enemies cannot use Block against you." }}] },
    { "id": "skill_force_shield",      "name": "Force Shield",          "tags": ["block","permanent"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["effect_shield"],"vote_log":[],"notes":"","data":{ "action_type":"B", "is_permanent":true, "point_buy_stat":"stat_vitality", "text":"Subtract the Shield permanent die value from effect damage before rounding. Destroy this permanent if effect damage is taken." }}] },
    { "id": "skill_barricade",         "name": "Barricade",             "tags": ["block","permanent"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_taunt"],"vote_log":[],"notes":"","data":{ "action_type":"B", "is_permanent":true, "point_buy_stat":"stat_vitality", "text":"Nearby enemies cannot use Attack against you." }}] },
    { "id": "skill_sanctuary",         "name": "Sanctuary",             "tags": ["block","permanent","invincible"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_force_shield","effect_the_void"],"vote_log":[],"notes":"","data":{ "action_type":"B", "is_permanent":true, "point_buy_stat":"any", "text":"Permanent until doing action. You, any permanent, and any token you control (besides Sanctuary) are invincible until you emit or perform any action." }}] },

    { "id": "skill_disruption_move",   "name": "Disruption",            "tags": ["move","lock"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_ranged_weapon"],"vote_log":[],"notes":"","data":{ "action_type":"M", "is_permanent":false, "point_buy_stat":null, "text":"The enemy cannot use Posture; any Empty Posture is always played as Empty Move (enemy cannot emit non-instant effects)." }}] },
    { "id": "skill_dodge",             "name": "Dodge / Evasion",       "tags": ["move","defense"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_bluff"],"vote_log":[],"notes":"","data":{ "action_type":"M", "is_permanent":false, "point_buy_stat":null, "text":"−1 combat damage (one less damage done to you this action)." }}] },
    { "id": "skill_bluff",             "name": "Bluff / Feint",         "tags": ["move","counter"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_dodge","skill_intimidation"],"vote_log":[],"notes":"","data":{ "action_type":"M", "is_permanent":false, "point_buy_stat":null, "text":"Negate enemy's action and replace it with Empty Posture." }}] },

    { "id": "skill_intimidation",      "name": "Intimidation",          "tags": ["posture","lock"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["skill_grapple"],"vote_log":[],"notes":"","data":{ "action_type":"P", "is_permanent":false, "point_buy_stat":null, "text":"The enemy cannot use Attack until end of round." }}] },
    { "id": "skill_battle_trance",     "name": "Battle trance",         "tags": ["posture","economy"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["effect_haste"],"vote_log":[],"notes":"","data":{ "action_type":"P", "is_permanent":false, "point_buy_stat":null, "text":"You may use another action this turn; choose both or one for the calculations." }}] },
    { "id": "skill_counter_spell",     "name": "Counter spell",         "tags": ["posture","counter"], "versions": [{ "version":"1.0.0","weight":1.0,"status":"canonical","origin":"paper_rules","author_peer_id":"","created_at":"2026-10-19","parent_version":null,"rebalance_links":["effect_disable","effect_shield"],"vote_log":[],"notes":"","data":{ "action_type":"P", "is_permanent":false, "point_buy_stat":null, "text":"Counter target non-permanent skill; emit an element against the enemy, subtract the element stat from the enemy's stat." }}] }
  ]
}
