# Dependencies
node_modules/

# Shipped binaries go into firebase/public/downloads/ for hosting, not git
firebase/public/downloads/*.apk
firebase/public/downloads/*.aab

# Play Store release — never commit the service-account JSON or the keystore
fastlane/play-service-account.json
fastlane/report.xml
fastlane/Preview.html
godot/release.keystore
godot/*.jks

# OCI deploy — keep private keys and local terraform state out of git
infra/oci/keys/
!infra/oci/keys/.gitkeep
infra/oci/.terraform/
infra/oci/.terraform.lock.hcl
infra/oci/terraform.tfstate
infra/oci/terraform.tfstate.backup
infra/oci/terraform.tfvars

# Game runtime / downloaded content
game/node_modules/
game/gun-data/
game/radata/
game/sessions/
game/radicle-work/
game/radicle.git/
game/host.pid
game/host.log
game/logs/

# Windows Zone.Identifier metadata (NTFS alternate data streams)
*:Zone.Identifier
*Zone.Identifier

# Godot editor/import cache
godot/.godot/

# Local Godot binary (fetch with _tools/get_godot.sh)
_tools/godot
_tools/*.zip
_test/*.log

# dev UI audit output (screenshots, scratch probes)
game/tools/out/
*.tmj.tmp
*.tmj
photo_2026-11-03_15-37-46_phone_alive.jpg
photo_2026-11-03_15-38-28_phone_dead.jpg

# Built APK/IDSIG — regenerated by _tools/build_and_deploy.sh and uploaded to OCI
_tools/chaosd6-debug.apk
_tools/chaosd6-debug.apk.idsig
_tools/chaosd6-release.apk
_tools/chaosd6-release.apk.idsig
_tools/.emu-logs/

# Scratch outputs from the mobile build pipeline. All regenerable:
#   _tools/fetch_nodejs_mobile.sh  → downloads libnode.so + headers into _cache/
#   _tools/stage_peer_js.sh        → stages peer bundle into the plugin's assets
#                                    (and historically into _tools/_out/peer-pack.zip
#                                    when the lazy-OCI flow was active)
_tools/_cache/
_tools/_out/

.claude/

# Godot gradle build intermediates (regenerated on every APK export)
godot/android/build/.gradle/
godot/android/build/build/
godot/android/build/.cxx/
godot/android/build/outputs/

# Plugin build intermediates. The per-plugin .gitignore under
# godot/android/plugins/<name>/ also covers these; this root-level glob is
# defense-in-depth so a stray `git add -A` from a plugin dir can't sneak
# generated binaries into history.
#   build/, .gradle/, .cxx/   — gradle outputs
#   libs/                     — godot-lib.release.aar copies (87 MB each; staged
#                               by the dev setup, never committed)
#   *.aar                     — plugin AARs produced by `./gradlew assembleRelease`
#   src/main/jniLibs/         — libnode.so staged by _tools/fetch_nodejs_mobile.sh
#   src/main/cpp/node-headers/— C headers from the nodejs-mobile zip
#   src/main/assets/nodejs-project/ — peer bundle staged by stage_peer_js.sh
godot/android/plugins/*/build/
godot/android/plugins/*/.gradle/
godot/android/plugins/*/.cxx/
godot/android/plugins/*/libs/
godot/android/plugins/*/*.aar
godot/android/plugins/*.aar
godot/android/plugins/*/src/main/jniLibs/
godot/android/plugins/*/src/main/cpp/node-headers/
godot/android/plugins/*/src/main/assets/nodejs-project/

# Godot's export rewrites these on every `_tools/build_android_apk.sh` run:
#   assets/   — exported game resources (fully rebuilt from source)
#   res/mipmap-*/, res/mipmap/ — launcher icons regenerated from
#     launcher_icons/* in export_presets.cfg
#   res/values-*/godot_project_name_string.xml — per-locale app name from
#     package/name in the preset
#   src/debug/AndroidManifest.xml — merged final manifest after plugin merge
# All pure derived outputs; first-run install (`android_source.zip` unzip in
# build_android_apk.sh) puts initial copies on disk so the gradle build has
# something to overwrite.
godot/android/build/assets/
godot/android/build/res/mipmap/
godot/android/build/res/mipmap-*/
godot/android/build/res/values/godot_project_name_string.xml
godot/android/build/res/values-*/godot_project_name_string.xml
godot/android/build/src/debug/
godot/android/build/src/release/
godot/android/build/google-services.json
# NOTE: godot/android/build/resources/META-INF/services/... and the plugins'
# src/main/resources/META-INF/services/... are hand-written plugin
# registrations (Godot finds plugins through them) — source, keep tracked.

# Godot import sidecars. Inside godot/ they belong to the project and stay
# tracked; anywhere else they are strays written when Godot was run with a
# non-project directory as res:// (e.g. repo root), so ignore them.
*.import
!/godot/**/*.import
godot/android/plugins/nodejs_mobile/src/main/resources/META-INF/services/org.godotengine.godot.plugin.GodotPlugin
godot/android/plugins/webview_hud/src/main/resources/META-INF/services/org.godotengine.godot.plugin.GodotPlugin
godot/android/plugins/webview_hud/gradle/wrapper/gradle-wrapper.jar
godot/android/plugins/nodejs_mobile/gradle/wrapper/gradle-wrapper.jar
