# Dependencies
node_modules/

# OCI deploy — keep private keys and local terraform state out of git
infra/oci/keys/
!infra/oci/keys/.gitkeep
infra/oci/.terraform/
infra/oci/.terraform.lock.hcl
infra/oci/terraform.tfstate
infra/oci/terraform.tfstate.backup
infra/oci/terraform.tfvars

# Game runtime / downloaded content
game/node_modules/
game/gun-data/
game/sessions/
game/radicle-work/
game/radicle.git/

# Windows Zone.Identifier metadata (NTFS alternate data streams)
*:Zone.Identifier
*Zone.Identifier
game/host.log
game/logs/

# Godot editor/import cache
godot/.godot/

# Local Godot binary (fetch with _tools/get_godot.sh)
_tools/godot
_tools/*.zip
_test/*.log

# dev UI audit output (screenshots, scratch probes)
game/tools/out/
*.tmj.tmp
*.tmj
