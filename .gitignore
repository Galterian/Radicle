# Dependencies
node_modules/

# Shipped binaries go into firebase/public/downloads/ for hosting, not git
firebase/public/downloads/*.apk
firebase/public/downloads/*.aab

# Play Store release — never commit the service-account JSON or the keystore
fastlane/play-service-account.json
fastlane/report.xml
fastlane/Preview.html
godot/release.keystore
godot/*.jks

# OCI deploy — keep private keys and local terraform state out of git
infra/oci/keys/
!infra/oci/keys/.gitkeep
infra/oci/.terraform/
infra/oci/.terraform.lock.hcl
infra/oci/terraform.tfstate
infra/oci/terraform.tfstate.backup
infra/oci/terraform.tfvars

# Game runtime / downloaded content
game/node_modules/
game/gun-data/
game/sessions/
game/radicle-work/
game/radicle.git/

# Windows Zone.Identifier metadata (NTFS alternate data streams)
*:Zone.Identifier
*Zone.Identifier
game/host.log
game/logs/

# Godot editor/import cache
godot/.godot/

# Local Godot binary (fetch with _tools/get_godot.sh)
_tools/godot
_tools/*.zip
_test/*.log

# dev UI audit output (screenshots, scratch probes)
game/tools/out/
*.tmj.tmp
*.tmj
photo_2026-11-03_15-37-46_phone_alive.jpg
photo_2026-11-03_15-38-28_phone_dead.jpg

# Built APK — 44 MB, auto-uploaded to OCI by _tools/build_and_deploy.sh --release
_tools/chaosd6-release.apk
_tools/chaosd6-release.apk.idsig
_tools/.emu-logs/adb-proxy.log
_tools/.emu-logs/adb-server.log
_tools/.emu-logs/emulator.log
_tools/.emu-logs/ws-scrcpy.log
_tools/.emu-logs/scrcpy.log
.claude/
