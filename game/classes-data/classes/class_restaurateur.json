  },
  "data": {
    "ability_kind": "static",
    "colors": [
      "elem_space",
      "elem_air",
      "elem_water",
      "elem_earth",
      "elem_fire"
    ],
    "text": "Instead of destroying tokens you may put them under your control on the same tile or over your permanent (as replacement if applicable)."
