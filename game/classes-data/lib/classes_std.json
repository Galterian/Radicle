{
  "schema": "chaosd6.class-lib/1",
  "id": "classes_std",
  "version": "1.0.0",
  "description": "Shared subroutines of the chaosD6 classes (C2) and the std programs of the class-generic hooks every class has (colours, kind, ready, config, strike, restore, progress, life_points) — used when a definition has no program of its own for them.",
  "defaults": {"colours":"colours","kind":"kind","ready":"ready","config":"cfg_default","strike":"strike","restore":"restore","progress":"progress","life_points":"life_points"},
  "subs": {
    "nat": {"params":["v","d"],"doc":"class-*.mjs num(): v when a non-negative integer, else d","body":{"if":[{"and":[{"is_int":{"var":"v"}},{">=":[{"var":"v"},0]}]},{"var":"v"},{"var":"d"}]}},
    "pos_int": {"params":["v","lo"],"doc":"class-world.mjs posInt(): Number.isInteger(v) && v >= lo","body":{"and":[{"is_int":{"var":"v"}},{">=":[{"var":"v"},{"var":"lo"}]}]}},
    "range_of": {"params":[],"doc":"peer.mjs classRangeOf: data.range when an integer, else 3 (\"nearby\")","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"if":[{"is_int":{"var":"d.range"}},{"var":"d.range"},3]}]}},
    "trap_power": {"params":[],"doc":"effects.mjs TRAP_POWER (the fixed power of a class trap)","body":20},
    "done": {"params":["note","out","log"],"doc":"an ability that fired: {used, note, log, mine, out}","body":{"obj":{"used":true,"note":{"var":"note"},"log":{"var":"log"},"mine":[],"out":{"var":"out"}}}},
    "not_done": {"params":["mine"],"doc":"an ability that found nothing to do (stays ready): {used:false, …}; mine = lines the actor logs","body":{"obj":{"used":false,"note":null,"log":[],"mine":{"var":"mine"},"out":{"obj":{}}}}},
    "ab_peer": {"params":[],"doc":"the character the click points at (args ab.target)","body":{"if":[{"===":[{"var":"ab.target.kind"},"character"]},{"var":"ab.target.ref"},null]}},
    "ab_tile": {"params":[],"doc":"the tile the click points at","body":{"if":[{"===":[{"var":"ab.target.kind"},"tile"]},{"var":"ab.target.ref"},null]}},
    "me_view": {"params":[],"doc":"my snapshot (or {})","body":{"or":[{"view":[{"var":"actor"}]},{"obj":{}}]}},
    "near_ally": {"params":["me","p"],"doc":"the pointed unit when it is a living ally next to me, else null","body":{"if":[{"and":[{"bool":{"var":"p"}},{"!==":[{"var":"p"},{"var":"me"}]},{">":[{"life_of":[{"var":"p"}]},0]},{"<=":[{"dist":[{"var":"me"},{"var":"p"}]},1]},{"!":{"enemy_of":[{"var":"me"},{"var":"p"}]}}]},{"var":"p"},null]}},
    "adjacent_of": {"params":["id"],"doc":"living units next to id (view order; the caller filters further and sorts)","body":{"filter":[{"view_ids":[]},{"and":[{"!==":[{"var":"o"},{"var":"id"}]},{">":[{"life_of":[{"var":"o"}]},0]},{"<=":[{"dist":[{"var":"id"},{"var":"o"}]},1]}]},"o"]}},
    "foes_nearby": {"params":["id","range"],"doc":"living visible enemies within range, sorted (peer.mjs foesNearby)","body":{"sort":{"filter":[{"view_ids":[]},{"and":[{"!==":[{"var":"o"},{"var":"id"}]},{">":[{"life_of":[{"var":"o"}]},0]},{"enemy_of":[{"var":"id"},{"var":"o"}]},{"<=":[{"dist":[{"var":"id"},{"var":"o"}]},{"var":"range"}]},{"!":{"has_perm":[{"var":"o"},"effect_invisibility"]}}]},"o"]}}},
    "pick_by_salt": {"params":["seed","list"],"doc":"effects.mjs pickBySalt: list[first 8 hex of sha(seed) % len] | null","body":{"if":[{"len":{"var":"list"}},{"at":[{"var":"list"},{"%":[{"hash_int":[{"var":"seed"},0,8]},{"len":{"var":"list"}}]}]},null]}},
    "bare": {"params":["id"],"doc":"no armor point on the unit (!Number(view.armor))","body":{"!":{"+":[{"get":[{"view":[{"var":"id"}]},"armor"]}]}}},
    "is_wild": {"params":["s"],"doc":"class-chase.mjs isWildMonster","body":{"and":[{"bool":{"var":"s"}},{"or":[{"===":[{"get":[{"var":"s"},"monster_state"]},"sleeping"]},{"===":[{"get":[{"var":"s"},"monster_state"]},"awake"]}]},{"!":{"bool":{"get":[{"var":"s"},"owner_peer_id"]}}}]}},
    "rides": {"params":["codes","req"],"doc":"skills.mjs ridesOn: own code, or M / P on EM / EP","body":{"or":[{"in":[{"var":"req"},{"var":"codes"}]},{"and":[{"or":[{"===":[{"var":"req"},"M"]},{"===":[{"var":"req"},"P"]}]},{"or":[{"in":["EP",{"var":"codes"}]},{"in":["EM",{"var":"codes"}]}]}]}]}},
    "colours": {"params":[],"doc":"std colours: the class elements grouped by stat, as [[stat, [elems]]…] pairs (first-seen order)","body":{"reduce":[{"or":[{"get":[{"class_data":[{"var":"class"}]},"colors"]},[]]},{"let":[{"st":{"elem_stat":[{"var":"current"}]}},{"if":[{"!":{"bool":{"var":"st"}}},{"var":"acc"},{"some":[{"var":"acc"},{"===":[{"at":[{"var":"p"},0]},{"var":"st"}]},"p"]},{"map":[{"var":"acc"},{"if":[{"===":[{"at":[{"var":"p"},0]},{"var":"st"}]},[{"at":[{"var":"p"},0]},{"concat":[{"at":[{"var":"p"},1]},[{"var":"current"}]]}],{"var":"p"}]},"p"]},{"concat":[{"var":"acc"},[[{"var":"st"},[{"var":"current"}]]]]}]}]},[]]}},
    "kind": {"params":[],"doc":"std kind: 'passive' (passiveTurn flag, data.passive ?? handDefaults.passive) | data.ability_kind | 'static'","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"if":[{"or":[{"bool":{"class_flag":[{"var":"class"},"passiveTurn"]}},{"bool":{"if":[{"is_null":{"var":"d.passive"}},{"get":[{"class_flag":[{"var":"class"},"handDefaults"]},"passive"]},{"var":"d.passive"}]}}]},"passive",{"or":[{"var":"d.ability_kind"},"static"]}]}]}},
    "ready": {"params":[],"doc":"std ready: stands on the board (class id, not archived, held) and tap → not tapped / else → not used this turn. Registers cs, held, turn","body":{"and":[{"===":[{"var":"cs.class_id"},{"var":"class"}]},{"!":{"bool":{"var":"cs.archived"}}},{"bool":{"var":"held"}},{"if":[{"===":[{"call":["kind"]},"tap"]},{"!":{"bool":{"var":"cs.tapped"}}},{"!==":[{"var":"cs.usedTurn"},{"var":"turn"}]}]}]}},
    "cfg_default": {"params":[],"doc":"std config: {range}","body":{"obj":{"range":{"call":["range_of"]}}}},
    "strike": {"params":[],"doc":"std strike (Rule 24 on a class colour, user ruling 2026-10-30): null when no standing colour is in reach; die of 6 → destroyed; last = every other colour already down. Registers cs, cols, stat, elem, enemy, pb","body":{"if":[{"!":{"and":[{"bool":{"var":"enemy"}},{"bool":{"var":"cs.class_id"}},{"!":{"bool":{"var":"cs.archived"}}},{"has_key":[{"var":"cols"},{"var":"stat"}]},{"!":{"in":[{"var":"stat"},{"or":[{"var":"cs.down"},[]]}]}},{"or":[{"!":{"bool":{"var":"elem"}}},{"in":[{"var":"elem"},{"get":[{"var":"cols"},{"var":"stat"}]}]}]}]}},null,{"let":[{"result":{"if":[{"var":"pb.fail"},"retry",{">=":[{"var":"pb.value"},6]},"destroyed","too weak"]}},{"obj":{"result":{"var":"result"},"ok":{"===":[{"var":"result"},"destroyed"]},"last":{"and":[{"===":[{"var":"result"},"destroyed"]},{"all":[{"keys":[{"var":"cols"}]},{"or":[{"===":[{"var":"s"},{"var":"stat"}]},{"in":[{"var":"s"},{"or":[{"var":"cs.down"},[]]}]}]},"s"]}]}}}]}]}},
    "restore": {"params":[],"doc":"std restore: may stat be emitted to recast (archived) / untap (tapped, on the board) — a colour not already done. Registers cs, cols, stat, kind","body":{"and":[{"bool":{"var":"cs.class_id"}},{"has_key":[{"var":"cols"},{"var":"stat"}]},{"if":[{"===":[{"var":"kind"},"recast"]},{"bool":{"var":"cs.archived"}},{"and":[{"bool":{"var":"cs.tapped"}},{"!":{"bool":{"var":"cs.archived"}}}]}]},{"!":{"and":[{"===":[{"var":"cs.progress.mode"},{"var":"kind"}]},{"in":[{"var":"stat"},{"or":[{"var":"cs.progress.done"},[]]}]}]}}]}},
    "progress": {"params":[],"doc":"std progress: one landed class outcome on MY class state → {state, event}. Registers state, cols, co","body":{"let":[{"down":{"or":[{"var":"state.down"},[]]},"archived":{"bool":{"var":"state.archived"}},"tapped":{"bool":{"var":"state.tapped"}},"prog":{"if":[{"var":"state.progress"},{"obj":{"mode":{"var":"state.progress.mode"},"done":{"or":[{"var":"state.progress.done"},[]]}}},null]}},{"if":[{"===":[{"var":"co.kind"},"colour"]},{"obj":{"state":{"obj":{"down":{"if":[{"in":[{"var":"co.stat"},{"var":"down"}]},{"var":"down"},{"concat":[{"var":"down"},[{"var":"co.stat"}]]}]},"archived":{"var":"archived"},"tapped":{"var":"tapped"},"progress":{"var":"prog"}}},"event":"colour"}},{"===":[{"var":"co.kind"},"class_destroyed"]},{"obj":{"state":{"obj":{"down":{"var":"cols"},"archived":true,"tapped":false,"progress":null}},"event":"destroyed"}},{"or":[{"===":[{"var":"co.kind"},"recast"]},{"===":[{"var":"co.kind"},"untap"]}]},{"let":[{"p0":{"if":[{"and":[{"bool":{"var":"prog"}},{"===":[{"var":"prog.mode"},{"var":"co.kind"}]}]},{"var":"prog"},{"obj":{"mode":{"var":"co.kind"},"done":[]}}]}},{"let":[{"dn":{"if":[{"in":[{"var":"co.stat"},{"var":"p0.done"}]},{"var":"p0.done"},{"concat":[{"var":"p0.done"},[{"var":"co.stat"}]]}]}},{"let":[{"complete":{"all":[{"var":"cols"},{"in":[{"var":"x"},{"var":"dn"}]},"x"]}},{"if":[{"and":[{"var":"complete"},{"===":[{"var":"co.kind"},"recast"]}]},{"obj":{"state":{"obj":{"down":[],"archived":false,"tapped":{"var":"tapped"},"progress":null}},"event":"recast"}},{"var":"complete"},{"obj":{"state":{"obj":{"down":{"var":"down"},"archived":{"var":"archived"},"tapped":false,"progress":null}},"event":"untap"}},{"obj":{"state":{"obj":{"down":{"var":"down"},"archived":{"var":"archived"},"tapped":{"var":"tapped"},"progress":{"obj":{"mode":{"var":"p0.mode"},"done":{"var":"dn"}}}}},"event":"step"}}]}]}]}]},{"obj":{"state":{"obj":{"down":{"var":"down"},"archived":{"var":"archived"},"tapped":{"var":"tapped"},"progress":{"var":"prog"}}},"event":null}}]}]}},
    "life_points": {"params":[],"doc":"std life_points: the illusion point goes first, then the armor point, then the chase bonus. Registers dmg, illusion, armor, chaseBonus","body":{"let":[{"a":{"and":[{">":[{"var":"dmg"},0]},{"bool":{"var":"illusion"}}]}},{"let":[{"h1":{"if":[{"var":"a"},1,0]}},{"let":[{"b":{"and":[{">":[{"var":"dmg"},{"var":"h1"}]},{"bool":{"var":"armor"}}]}},{"let":[{"h2":{"+":[{"var":"h1"},{"if":[{"var":"b"},1,0]}]}},{"let":[{"c":{"and":[{">":[{"var":"dmg"},{"var":"h2"}]},{"bool":{"var":"chaseBonus"}}]}},{"obj":{"illusion":{"if":[{"var":"a"},0,{"var":"illusion"}]},"armor":{"if":[{"var":"b"},0,{"var":"armor"}]},"chaseBonus":{"if":[{"var":"c"},0,{"var":"chaseBonus"}]},"absorbed":{"+":[{"var":"h2"},{"if":[{"var":"c"},1,0]}]}}}]}]}]}]}]}},
    "stance_by_flag": {"params":[],"doc":"flags.stance[code] ?? null. Registers code","body":{"let":[{"s":{"get":[{"class_flag":[{"var":"class"},"stance"]},{"var":"code"}]}},{"if":[{"is_null":{"var":"s"}},null,{"var":"s"}]}]}},
    "emits_by_flag": {"params":[],"doc":"flags.emits[code]: true = every site, [sites] = only there. Registers code, site","body":{"let":[{"e":{"get":[{"class_flag":[{"var":"class"},"emits"]},{"var":"code"}]}},{"or":[{"===":[{"var":"e"},true]},{"and":[{"is_array":{"var":"e"}},{"in":[{"var":"site"},{"var":"e"}]}]}]}]}},
    "cfg_rogue": {"params":[],"doc":"class-traps.mjs rogueConfig","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"obj":{"trapPerTurn":{"call":["nat",{"var":"d.trap_dodges_per_turn"},1]},"threatPerTurn":{"call":["nat",{"var":"d.threat_dodges_per_turn"},1]},"threatRadius":{"call":["nat",{"var":"d.threat_radius"},2]}}}]}},
    "cfg_cleric": {"params":[],"doc":"class-traps.mjs clericConfig","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"obj":{"range":{"call":["nat",{"var":"d.disable_range"},3]}}}]}},
    "cfg_manipulator": {"params":[],"doc":"class-manipulator.mjs manipulatorConfig","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"obj":{"range":{"call":["nat",{"var":"d.range"},3]},"publishRange":{"call":["nat",{"var":"d.publish_range"},6]}}}]}},
    "cfg_avenger": {"params":[],"doc":"class-chase.mjs avengerConfig","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"let":[{"cb":{"or":[{"var":"d.chase_bonus"},{"obj":{}}]}},{"obj":{"range":{"call":["nat",{"var":"d.lure_range"},10]},"per":{"call":["nat",{"var":"cb.life"},1]},"max":{"call":["nat",{"var":"cb.max"},1]}}}]}]}},
    "cfg_prophet": {"params":[],"doc":"class-chase.mjs prophetConfig + range + hand_reveal (HAND_CLASS_DEFAULTS)","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"obj":{"contact":{"call":["nat",{"var":"d.contact"},1]},"range":{"call":["range_of"]},"hand_reveal":{"or":[{"var":"d.hand_reveal"},{"get":[{"class_flag":[{"var":"class"},"handDefaults"]},"hand_reveal"]},null]}}}]}},
    "cfg_animator": {"params":[],"doc":"class-world.mjs animatorConfig","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"obj":{"near":{"if":[{"call":["pos_int",{"var":"d.near"},1]},{"var":"d.near"},2]},"place":{"if":[{"call":["pos_int",{"var":"d.place_range"},1]},{"var":"d.place_range"},1]}}}]}},
    "cfg_priest": {"params":[],"doc":"class-world.mjs priestConfig","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"let":[{"b":{"if":[{"and":[{"bool":{"var":"d.building"}},{"or":[{"===":[{"type_of":[{"var":"d.building"}]},"object"]},{"===":[{"type_of":[{"var":"d.building"}]},"array"]}]}]},{"var":"d.building"},{"obj":{}}]}},{"obj":{"place":{"if":[{"call":["pos_int",{"var":"d.place_range"},1]},{"var":"d.place_range"},2]},"label":{"if":[{"and":[{"===":[{"type_of":[{"var":"b.label"}]},"string"]},{"bool":{"var":"b.label"}}]},{"var":"b.label"},"Shrine"]},"power":{"if":[{"and":[{"===":[{"type_of":[{"var":"b.power"}]},"string"]},{"bool":{"var":"b.power"}}]},{"var":"b.power"},"mend"]}}}]}]}},
    "cfg_seeker": {"params":[],"doc":"class-world.mjs seekerConfig","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"let":[{"ok":{"and":[{"is_array":{"var":"d.distance"}},{"===":[{"len":{"var":"d.distance"}},2]},{"all":[{"var":"d.distance"},{"call":["pos_int",{"var":"x"},1]},"x"]},{"<=":[{"at":[{"var":"d.distance"},0]},{"at":[{"var":"d.distance"},1]}]}]}},{"obj":{"min":{"if":[{"var":"ok"},{"at":[{"var":"d.distance"},0]},20]},"max":{"if":[{"var":"ok"},{"at":[{"var":"d.distance"},1]},30]},"radius":{"if":[{"call":["pos_int",{"var":"d.vision.radius"},0]},{"var":"d.vision.radius"},5]},"turns":1}}]}]}},
    "cfg_witch": {"params":[],"doc":"peer.mjs classRangeOf + handDiscardOf (HAND_CLASS_DEFAULTS)","body":{"let":[{"d":{"class_data":[{"var":"class"}]}},{"obj":{"range":{"call":["range_of"]},"hand_discard":{"or":[{"var":"d.hand_discard"},{"get":[{"class_flag":[{"var":"class"},"handDefaults"]},"hand_discard"]},null]}}}]}}
  }
}
