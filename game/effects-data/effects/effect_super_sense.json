{
  "schema": "chaosd6.effect/2",
  "id": "effect_super_sense",
  "name": "Super sense",
  "version": "1.3.0",
  "source": {
    "collection": "effects",
    "version": "1.1.0"
  },
  "elements": [
    "elem_vitality"
  ],
  "cost": 1,
  "kind": "scouting",
  "duration": "permanent",
  "every": {
    "behaviour": "resolver",
    "note": "adjacent traps listed; spent to evade one point of damage (peer.mjs)"
  },
  "text": "Look at a neighboring location without activating the trap and reveal its contents to others. Remove the Super Sense permanent to evade one damage.",
  "flags": {
    "permanent": true,
    "sensesTraps": true
  },
  "bot": {
    "defence": true
  },
  "ui": {
    "perm_help": "Super Sense — the traps on the six tiles around you are shown to you; the first point of damage that would land on you is evaded and the permanent spent"
  },
  "standing": {
    "damage_in": {
      "if": [
        {
          ">": [
            {
              "var": "amount"
            },
            0
          ]
        },
        {
          "obj": {
            "amount": {
              "-": [
                {
                  "var": "amount"
                },
                1
              ]
            },
            "spend": true
          }
        },
        {
          "obj": {
            "amount": {
              "var": "amount"
            },
            "spend": false
          }
        }
      ]
    }
  },
  "card": {
    "name": "Super sense",
    "tags": [
      "point_buy",
      "permanent",
      "scout"
    ],
    "resources": {
      "source": "warlords3_battlecry",
      "wbc3_name": "Yellow light orb glow growing (sizes)",
      "wbc3_code": "ELIT",
      "wbc3_race": "Effects1",
      "match_reason": "growing light orb = heightened perception revealing a tile",
      "confidence": "medium",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Yellow light orb glow growing (sizes)/Yellow light orb glow growing (sizes) - idle [ELIT].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex"
        }
      },
      "sounds": {
        "spell": [
          {
            "path": "assets/Sounds/SoundFX/STEZ06.wav",
            "usage": "WBC3 spell-cast sound paired with the EZ effect; play when the effect is cast"
          }
        ],
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/Sparkles.wav",
            "usage": "sound effect on resolution / impact of the effect"
          }
        ]
      }
    },
    "data": {
      "effect_types": [
        "point_buy",
        "permanent"
      ],
      "element_cost": [
        "elem_vitality"
      ],
      "text": "Look at a neighboring location without activating the trap and reveal its contents to others. Remove the Super Sense permanent to evade one damage."
    },
    "rebalance_links": [
      "effect_vision"
    ],
    "logic": {
      "description": "Implemented 2026-10-29. A Vitality permanent (power = placement die). While it stands the traps on the six tiles around me are known to me without springing them (they stay where they are; the UI lists them). The first point of damage that would land on me is evaded instead and the permanent is spent for it.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "permanent_power",
          "description": "Rule 24 threshold of the permanent: the kept point-buy die of its placement.",
          "target": "caster",
          "unit": "die",
          "value": {
            "var": "die"
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "Rule 24: an adjacent enemy emitting the matching stat destroys this permanent when their highest die is at least its power.",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "var": "power"
                }
              }
            ]
          }
        },
        {
          "id": "damage_evaded_on_removal",
          "description": "Damage evaded when the permanent is spent (the first point that would land).",
          "target": "caster",
          "unit": "damage",
          "value": 1
        },
        {
          "id": "scout_reach",
          "description": "Hexes around me whose traps I see.",
          "target": "caster",
          "unit": "hexes",
          "value": 1
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_vitality (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_vitality"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_permanent",
          "description": "effect_types keeps \"permanent\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "permanent"
            ]
          }
        },
        {
          "id": "keeps_type_point_buy",
          "description": "effect_types keeps \"point_buy\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "point_buy"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "using_rule_24"
      ]
    }
  },
  "uses": [
    "std",
    "e2a"
  ],
  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "land_permanent"
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
