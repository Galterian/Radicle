                                        "var": "effect_id"
                                      }
                                    }
                                  }
                                ]
                              },
                              {
                                "if": [
                                  {
                                    ">": [
                                      {
                                        "var": "small"
                                      },
                                      0
                                    ]
                                  },
                                  {
                                    "emit": [
                                      "statTokens",
                                      {
                                        "obj": {
                                          "on": {
                                            "var": "who"
                                          },
                                          "stat": {
                                            "at": [
                                              {
                                                "var": "low"
                                              },
                                              0
                                            ]
                                          },
                                          "elem": {
                                            "at": [
                                              {
                                                "var": "elems"
                                              },
                                              0
                                            ]
                                          },
                                          "value": {
                                            "var": "small"
                                          },
                                          "effect_id": {
                                            "var": "effect_id"
                                          }
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "seq": [
                              {
                                "emit": [
                                  "statTokens",
                                  {
