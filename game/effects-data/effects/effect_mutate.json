                                      "on": {
                                        "var": "who"
                                      },
                                      "stat": {
                                        "at": [
                                          {
                                            "var": "high"
                                          },
                                          0
                                        ]
                                      },
                                      "elem": {
                                        "at": [
                                          {
                                            "var": "elems"
                                          },
                                          0
                                        ]
                                      },
                                      "value": {
                                        "-": [
                                          {
                                            "var": "big"
                                          }
                                        ]
                                      },
