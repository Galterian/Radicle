      "match_reason": "green dome + WBC3 Morph sound",
      "confidence": "medium",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Green dome arcs/Green dome arcs - idle [EZ43].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex",
          "blend": "additive"
        }
      },
      "sounds": {
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/Morph.WAV",
            "usage": "sound effect on resolution / impact of the effect"
