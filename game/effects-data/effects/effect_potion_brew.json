{
  "schema": "chaosd6.effect/2",
  "id": "effect_potion_brew",
  "name": "Potion brew",
  "version": "1.2.0",
  "source": {
    "collection": "effects",
    "version": "1.0.0"
  },
  "elements": [
    "elem_vitality"
  ],
  "cost": 1,
  "kind": "stat_token",
  "duration": "instant",
  "every": {
    "behaviour": "none"
  },
  "text": "Create a distributive potion; the target puts an element token over their hero as a permanent bonus until someone destroys it by point-buy.",
  "flags": {
    "scope": "self_or_ally",
    "statBonus": [
      "elem_vitality"
    ]
  },
  "bot": {
    "tags": [
      "brute",
      "defender",
      "pack",
      "support"
    ],
    "names": [
      "angel|mercy",
      "shaman|mystic|everbark|loxodon"
    ],
    "defence": true,
    "heals_self": true
  },
  "card": {
    "name": "Potion brew",
    "tags": [
      "permanent",
      "buff"
    ],
    "resources": {
      "source": "warlords3_battlecry",
      "wbc3_name": "Green sparkle clusters",
      "wbc3_code": "EZ77",
      "wbc3_race": "Effects1",
      "match_reason": "green alchemical sparkles; DwarvenBrew is the WBC3 brewing sound",
      "confidence": "medium",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Green sparkle clusters/Green sparkle clusters - idle [EZ77].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex"
        }
      },
      "sounds": {
        "spell": [
          {
            "path": "assets/Sounds/SoundFX/STEZ36.wav",
            "usage": "WBC3 spell-cast sound paired with the EZ effect; play when the effect is cast"
          }
        ],
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/DwarvenBrew.wav",
            "usage": "sound effect on resolution / impact of the effect"
          }
        ]
      }
    },
    "data": {
      "effect_types": [
        "permanent",
        "point_buy"
      ],
      "element_cost": [
        "elem_vitality"
      ],
      "text": "Create a distributive potion; the target puts an element token over their hero as a permanent bonus until someone destroys it by point-buy."
    },
    "rebalance_links": [
      "effect_artifice",
      "effect_mutate"
    ],
    "logic": {
      "description": "Implemented. A Vitality point-buy becomes a +die token on the Vitality stat of the caster or of a right-clicked living ally in contact (the distributed potion); permanent until destroyed by a Rule 24 point-buy. Under Aura the adjacent allies all get a token, under Aura ∀ everyone within 10. A failed roll re-emits.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        },
        {
          "id": "self_or_adjacent_ally",
          "description": "The recipient is the caster, or a living ally in contact that the caster right-clicked.",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                "==": [
                  {
                    "var": "target.id"
                  },
                  {
                    "var": "caster.id"
                  }
                ]
              },
              {
                "and": [
                  {
                    "rule": [
                      "is_ally",
                      {
                        "a_alliance": {
                          "var": "caster.alliance"
                        },
                        "b_alliance": {
                          "var": "target.alliance"
                        }
                      }
                    ]
                  },
                  {
                    "rule": [
                      "in_contact",
                      {
                        "dist": {
                          "var": "dist"
                        }
                      }
                    ]
                  },
                  {
                    ">": [
                      {
                        "var": "target.life"
                      },
                      0
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "stat_bonus_token",
          "description": "A point-buy on the caster elem_vitality stat; the highest die becomes a +die token on the recipient stat behind elem_vitality (permanent until destroyed by Rule 24).",
          "target": "target",
          "unit": "stat",
          "value": {
            "var": "die"
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "Rule 24: an enemy point-buy die of the matching stat destroys this permanent when it is at least the token value behind the cast element.",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "max_of": [
                    {
                      "map": [
                        {
                          "filter": [
                            {
                              "var": "caster.tokens"
                            },
                            {
                              "==": [
                                {
                                  "var": "elem"
                                },
                                {
                                  "root": "elements.0"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "var": "value"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_vitality (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_vitality"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_permanent",
          "description": "effect_types keeps \"permanent\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "permanent"
            ]
          }
        },
        {
          "id": "keeps_type_point_buy",
          "description": "effect_types keeps \"point_buy\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "point_buy"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "in_contact",
        "is_ally",
        "using_rule_24"
      ]
    }
  },
  "uses": [
    "std",
    "e2a"
  ],
  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "targets",
          "self_or_ally",
          1,
          false
        ]
      },
      {
        "map": [
          {
            "var": "recipients"
          },
          {
            "call": [
              "stat_token",
              {
                "var": "who"
              },
              "elem_vitality",
              1,
              "bonus"
            ]
          },
          "who"
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
