{
  "schema": "chaosd6.effect/2",
  "id": "effect_sleep",
  "name": "Sleep",
  "version": "1.3.0",
  "source": {
    "collection": "effects",
    "version": "1.1.0"
  },
  "elements": [
    "elem_souls",
    "elem_concentration"
  ],
  "cost": 2,
  "kind": "trap",
  "duration": "trap",
  "every": {
    "behaviour": "resolver",
    "note": "enter trap; the afflicted enemy cannot cast while in contact (peer.mjs)"
  },
  "text": "Set as a trap on your location. Enemy cannot cast effects while in contact. On trap resolve: effect becomes Permanent targeting trapped character with power 20 point-buy.",
  "flags": {
    "trap": {
      "trigger": "enter",
      "mode": "perm"
    },
    "fixedPower": 6
  },
  "ui": {
    "perm_help": "Sleep (6) — the enemy who stepped onto your trap cannot cast effects while in contact with you"
  },
  "standing": {
    "afflicted": {
      "obj": {
        "no_cast": {
          "bool": {
            "var": "in_contact"
          }
        },
        "only": null
      }
    }
  },
  "card": {
    "name": "Sleep",
    "tags": [
      "trap",
      "lock"
    ],
    "resources": {
      "source": "warlords3_battlecry",
      "wbc3_name": "Spell effect faint white rings",
      "wbc3_code": "EZ08",
      "wbc3_race": "Effects1",
      "match_reason": "faint rings hovering over the sleeping target",
      "confidence": "low",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Spell effect faint white rings/Spell effect faint white rings - idle [EZ08].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex"
        }
      },
      "sounds": {
        "spell": [
          {
            "path": "assets/Sounds/SoundFX/STEZ08.wav",
            "usage": "WBC3 spell-cast sound paired with the EZ effect; play when the effect is cast"
          }
        ],
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/Night.wav",
            "usage": "sound effect on resolution / impact of the effect"
          }
        ]
      }
    },
    "data": {
      "effect_types": [
        "trap",
        "permanent"
      ],
      "element_cost": [
        "elem_souls",
        "elem_concentration"
      ],
      "text": "Set as a trap on your location. Enemy cannot cast effects while in contact. On trap resolve: effect becomes Permanent targeting trapped character with power 20 point-buy."
    },
    "rebalance_links": [
      "effect_oblivion",
      "effect_confusion"
    ],
    "logic": {
      "description": "Implemented (2026-10-29). The card lies face down under the caster; the first enemy that steps onto the tile springs it: the caster gains the card as a permanent (fixed power 6, Rule 24 — user ruling 2026-10-30: \"power 20 is my bad\") and the victim cannot cast effects while in contact with me while that permanent stands. Trap card routing per user ruling 2026-10-30 (see trap_card_routing).",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "trap_power",
          "description": "Power of the trap / resulting permanent: 20 (×2 when the two ∀ copies are chained).",
          "target": "tile",
          "unit": "die",
          "value": {
            "*": [
              20,
              {
                "if": [
                  {
                    "var": "cast.every"
                  },
                  2,
                  1
                ]
              }
            ]
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "The trapped character breaks the permanent with a point-buy whose die sum reaches the power.",
          "target": "target",
          "unit": "die",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "*": [
                    20,
                    {
                      "if": [
                        {
                          "var": "cast.every"
                        },
                        2,
                        1
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "trap_trigger",
          "description": "Springs on the first enemy that steps onto the trap tile.",
          "target": "tile",
          "unit": "trigger",
          "value": "enter"
        },
        {
          "id": "affliction",
          "description": "While the owner holds the sprung permanent: the victim cannot cast effects while in contact with me.",
          "target": "target",
          "unit": "affliction",
          "value": "effect_sleep"
        },
        {
          "id": "trap_card_routing",
          "description": "User ruling 2026-10-30: a trap under its owner goes back to the OWNER's discard pile; a trap on an unoccupied tile (enter trigger) goes to the discard pile of the unit that dealt with it (sprang it, or a Cleric with someone on the tile). Library-generated traps only ever exist as that card for the one who dealt with them.",
          "target": "card",
          "unit": "discard_pile",
          "value": {
            "if": [
              {
                "==": [
                  {
                    "var": "trap.trigger"
                  },
                  "enter"
                ]
              },
              {
                "var": "trap.victim"
              },
              {
                "var": "trap.owner"
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_souls (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_souls"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_trap",
          "description": "effect_types keeps \"trap\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "trap"
            ]
          }
        },
        {
          "id": "keeps_type_permanent",
          "description": "effect_types keeps \"permanent\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "permanent"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "using_rule_24"
      ]
    }
  },
  "uses": [
    "std",
    "e2a"
  ],
  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "trap_self",
          "enter",
          "perm"
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
