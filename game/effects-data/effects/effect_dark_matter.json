  "card": {
    "name": "Dark matter",
    "tags": [
      "damage",
      "token"
    ],
    "resources": {
      "source": "warlords3_battlecry",
      "wbc3_name": "Spell effect purplewhite glowing orbs",
      "wbc3_code": "EZ05",
      "wbc3_race": "Effects1",
      "match_reason": "purple-white orbs colliding",
      "confidence": "medium",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Spell effect purplewhite glowing orbs/Spell effect purplewhite glowing orbs - idle [EZ05].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex",
          "blend": "additive"
        }
      },
      "sounds": {
        "spell": [
          {
            "path": "assets/Sounds/SoundFX/STEZ05.wav",
            "usage": "WBC3 spell-cast sound paired with the EZ effect; play when the effect is cast"
          }
        ],
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/Boom.wav",
            "usage": "sound effect on resolution / impact of the effect"
          }
        ]
      }
    },
    "data": {
      "effect_types": [
        "damage",
        "point_buy",
        "permanent"
      ],
      "element_cost": [
        "elem_space",
        "elem_fire"
      ],
      "text": "Damage by colliding the target with the inverted target. + Also put a damage-shield Space AND Fire token on your tile."
    },
    "rebalance_links": [
      "effect_lightning"
    ],
    "logic": {
      "description": "Implemented point-buy damage (Space→World, Fire→Matter) to one enemy in contact, Σ kept ÷10 rounded half up; at completion the caster buys a Space and a Fire damage-shield token on its own tile (each absorbs one hit of its element). A failed token roll makes the cast retry. Aura / Aura ∀ widen the hit.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        },
        {
          "id": "target_in_reach",
          "description": "No declared target (the engine picks the enemy the cast hurts most within 1) or the right-clicked target is within 1 hex; through an Aura ∀ the reach is the whole view (10).",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                "if": [
                  {
                    "var": "cast.aura"
                  },
                  {
                    "rule": [
                      "in_view",
                      {
                        "dist": {
                          "var": "dist"
                        },
                        "radius": 10
                      }
                    ]
                  },
                  {
                    "rule": [
                      "in_contact",
                      {
                        "dist": {
                          "var": "dist"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "target_is_enemy",
          "description": "A declared target must be an enemy (exactly one side is npc_b); without one the engine aims at an enemy itself.",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                "rule": [
                  "is_enemy",
                  {
                    "a_alliance": {
                      "var": "caster.alliance"
                    },
                    "b_alliance": {
                      "var": "target.alliance"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "target_alive",
          "description": "A declared target must still be alive (life > 0); dead units are skipped.",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                ">": [
                  {
                    "var": "target.life"
                  },
                  0
                ]
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "point_buy_dice",
          "description": "Rule 20: one point-buy per emission on the caster stat behind the element going out; this is the total number of d6 the whole cast rolls (6·n nearest the stat, ties to more dice).",
          "target": "caster",
          "unit": "die",
          "value": {
            "sum": [
              {
                "map": [
                  {
                    "var": "elements"
                  },
                  {
                    "rule": [
                      "point_buy_dice_count",
                      {
                        "stat": {
                          "stat_of": [
                            {
                              "root": "caster"
                            },
                            {
                              "var": ""
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "point_buy_damage",
          "description": "Σ of the kept dice (one per element, the highest die of each successful roll) ÷10, rounded half up; a failed roll re-emits only that element (cast status retry).",
          "target": "target",
          "unit": "damage",
          "value": {
            "round_div10": [
              {
                "sum": [
                  {
                    "var": "cast.kept"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "self_shield_tokens",
          "description": "Damage-shield token(s) on the caster tile for elem_space and elem_fire: one point-buy each on the caster stat, highest die is the token value; a failed roll re-emits the last element.",
          "target": "tile",
          "unit": "tokens",
          "value": 2
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_space (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_space"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_fire (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_fire"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_damage",
          "description": "effect_types keeps \"damage\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "damage"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "in_contact",
        "in_view",
        "is_enemy",
        "point_buy_dice_count"
      ]
    }
  },
  "uses": [
    "std",
    "e2a"
  ],
  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "pointbuy_bank"
        ]
      },
      {
        "call": [
          "targets",
          "target",
          1,
          true
        ]
      },
      {
        "call": [
          "require_recipients"
        ]
      },
      {
        "map": [
          {
            "var": "recipients"
          },
          {
            "call": [
              "hit_with",
              {
                "var": "def"
              },
              [
                {
                  "obj": {
                    "kind": "main",
                    "sum": {
                      "call": [
                        "main_kept",
                        {
                          "var": "def"
                        }
                      ]
                    }
                  }
                }
              ],
              false,
              false
            ]
          },
          "def"
        ]
      },
      {
        "call": [
          "self_tile_token",
          "elem_space",
          "shield",
          "shield"
        ]
      },
      {
        "call": [
          "self_tile_token",
          "elem_fire",
          "shield",
          "shield"
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
