{
  "schema": "chaosd6.effect/2",
  "id": "effect_harm",
  "name": "Harm",
  "version": "1.2.0",
  "source": {
    "collection": "effects",
    "version": "1.0.0"
  },
  "elements": [
    "elem_vitality"
  ],
  "cost": 1,
  "kind": "damage",
  "duration": "channel",
  "every": {
    "behaviour": "resolver",
    "note": "channel ticks re-enter with cast._channel_tick (peer.mjs)"
  },
  "text": "Permanent until round-end. Put a temporary Vitality token as a defense token every action until contact with target; calculate damage each action.",
  "flags": {
    "damage": "pointbuy",
    "scope": "target",
    "permanent": true,
    "selfShieldTokens": [
      "elem_vitality"
    ],
    "channel": {
      "stop": "break"
    }
  },
  "bot": {
    "tags": [
      "bruiser",
      "brute"
    ],
    "names": [
      "giant|behemoth|gargantuan|ogre|minotaur|thoctar"
    ]
  },
  "ui": {
    "perm_help": "Harm (channel) — re-fires every action while you keep the Posture and emit nothing else; Attack / Block / Move / Empty Move break it"
  },
  "card": {
    "name": "Harm",
    "tags": [
      "damage",
      "instant",
      "channeling"
    ],
    "resources": {
      "source": "warlords3_battlecry",
      "wbc3_name": "Particle set red sparks",
      "wbc3_code": "EPA1",
      "wbc3_race": "Effects1",
      "match_reason": "red damage sparks for a direct harm channel",
      "confidence": "medium",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Particle set red sparks/Particle set red sparks - idle [EPA1].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex"
        }
      },
      "sounds": {
        "spell": [
          {
            "path": "assets/Sounds/SoundFX/STEZ17.wav",
            "usage": "WBC3 spell-cast sound paired with the EZ effect; play when the effect is cast"
          }
        ],
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/Whack.wav",
            "usage": "sound effect on resolution / impact of the effect"
          }
        ]
      }
    },
    "data": {
      "effect_types": [
        "damage",
        "instant",
        "point_buy",
        "channeling"
      ],
      "element_cost": [
        "elem_vitality"
      ],
      "text": "Permanent until round-end. Put a temporary Vitality token as a defense token every action until contact with target; calculate damage each action."
    },
    "rebalance_links": [
      "effect_drain",
      "effect_turn_life"
    ],
    "logic": {
      "description": "Implemented as a channel (general_ux_channeling, 2026-10-29). The Vitality emission buys dice; the kept die ÷10 is dealt to one enemy in contact and a Vitality shield token goes on the caster's tile. The card becomes a temporary permanent (power = smallest die) that re-fires the damage leg every subsequent action until the caster breaks concentration (A/B/M/EM or a non-Vitality emission) or the permanent is destroyed by Rule 24.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "An instant rides on any action (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": true
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        },
        {
          "id": "target_in_reach",
          "description": "No declared target (the engine picks the enemy the cast hurts most within 1) or the right-clicked target is within 1 hex; through an Aura ∀ the reach is the whole view (10).",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                "if": [
                  {
                    "var": "cast.aura"
                  },
                  {
                    "rule": [
                      "in_view",
                      {
                        "dist": {
                          "var": "dist"
                        },
                        "radius": 10
                      }
                    ]
                  },
                  {
                    "rule": [
                      "in_contact",
                      {
                        "dist": {
                          "var": "dist"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "target_is_enemy",
          "description": "A declared target must be an enemy (exactly one side is npc_b); without one the engine aims at an enemy itself.",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                "rule": [
                  "is_enemy",
                  {
                    "a_alliance": {
                      "var": "caster.alliance"
                    },
                    "b_alliance": {
                      "var": "target.alliance"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "target_alive",
          "description": "A declared target must still be alive (life > 0); dead units are skipped.",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                ">": [
                  {
                    "var": "target.life"
                  },
                  0
                ]
              }
            ]
          }
        },
        {
          "id": "channel_holds",
          "description": "general_ux_channeling: the channel stands while the caster neither Attacks, Blocks, Moves, Empty-Moves nor emits an element other than the cost element; any of those breaks it and the permanent falls.",
          "when": {
            "!": {
              "in": [
                {
                  "var": "caster.action"
                },
                [
                  "A",
                  "B",
                  "M",
                  "EM"
                ]
              ]
            }
          }
        }
      ],
      "effects": [
        {
          "id": "point_buy_dice",
          "description": "Rule 20: one point-buy per emission on the caster stat behind the element going out; this is the total number of d6 the whole cast rolls (6·n nearest the stat, ties to more dice).",
          "target": "caster",
          "unit": "die",
          "value": {
            "sum": [
              {
                "map": [
                  {
                    "var": "elements"
                  },
                  {
                    "rule": [
                      "point_buy_dice_count",
                      {
                        "stat": {
                          "stat_of": [
                            {
                              "root": "caster"
                            },
                            {
                              "var": ""
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "point_buy_damage",
          "description": "Σ of the kept dice (one per element, the highest die of each successful roll) ÷10, rounded half up; a failed roll re-emits only that element (cast status retry).",
          "target": "target",
          "unit": "damage",
          "value": {
            "round_div10": [
              {
                "sum": [
                  {
                    "var": "cast.kept"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "channel_tick",
          "description": "Every subsequent action the channel re-fires its leg (point-buy damage on the target) with the caster's current stats, at no further cost, until broken.",
          "target": "caster",
          "unit": "per_action",
          "value": true
        },
        {
          "id": "channel_permanent_power",
          "description": "The channel permanent stands on the SMALLEST die of its placement roll (Rule 24 threshold).",
          "target": "caster",
          "unit": "die",
          "value": {
            "min_of": [
              {
                "var": "cast.dice"
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_vitality (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_vitality"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_damage",
          "description": "effect_types keeps \"damage\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "damage"
            ]
          }
        },
        {
          "id": "keeps_type_instant",
          "description": "effect_types keeps \"instant\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "instant"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "in_contact",
        "in_view",
        "is_enemy",
        "point_buy_dice_count"
      ]
    }
  },
  "uses": [
    "std",
    "e2a"
  ],
  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "pointbuy_bank"
        ]
      },
      {
        "call": [
          "targets",
          "target",
          1,
          true
        ]
      },
      {
        "call": [
          "require_recipients"
        ]
      },
      {
        "map": [
          {
            "var": "recipients"
          },
          {
            "call": [
              "hit_with",
              {
                "var": "def"
              },
              [
                {
                  "obj": {
                    "kind": "main",
                    "sum": {
                      "call": [
                        "main_kept",
                        {
                          "var": "def"
                        }
                      ]
                    }
                  }
                }
              ],
              false,
              false
            ]
          },
          "def"
        ]
      },
      {
        "call": [
          "self_tile_token",
          "elem_vitality",
          "shield",
          "shield"
        ]
      },
      {
        "call": [
          "land_permanent"
        ]
      },
      {
        "call": [
          "channel_reg",
          "break"
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
