    "rebalance_links": [
      "effect_super_force"
    ],
    "logic": {
      "description": "Reworked 2026-10-29 as Force Smash / Pull. With an enemy in contact: delta damage on Air (Will). Otherwise Force Pull: a bonus tile token on an adjacent tile not under an ally (the element where my stat is biggest first) is contested with an Air point-buy as under Rule 24 — the die ≥ the token value moves the token onto my tile (general_ux_tokens: one per element, bigger wins).",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "delta_damage",
          "description": "Rule 21 (pc): Σ over the cast elements of max(caster stat − defender stat, 0), ÷10, rounded half up; a Force Shield die is subtracted from the Σ before rounding (peer side).",
          "target": "target",
          "unit": "damage",
          "value": {
            "rule": [
              "rule_21_delta_damage",
              {
                "caster": {
                  "root": "caster"
                },
                "defender": {
                  "root": "defender"
                },
                "elements": {
                  "root": "elements"
                }
              }
            ]
          }
        },
        {
          "id": "force_pull",
          "description": "No enemy in reach → the adjacent bonus token (not under an ally; my biggest stat's element first) is pulled onto my tile when my Air die is at least its value.",
          "target": "tile",
          "unit": "die",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "var": "token.value"
                }
              }
            ]
          }
        },
        {
          "id": "one_token_per_element",
          "description": "general_ux_tokens: one token per element on a tile — the new one stands only if it is bigger than the one already there.",
          "target": "tile",
          "unit": "rule",
          "value": {
            ">": [
              {
                "var": "token.value"
              },
              {
                "max_of": [
                  {
                    "map": [
                      {
                        "filter": [
                          {
                            "var": "tile.tokens"
                          },
                          {
                            "==": [
                              {
                                "var": "elem"
                              },
                              {
                                "root": "token.elem"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "var": "value"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_air (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_air"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_damage",
          "description": "effect_types keeps \"damage\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "damage"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "rule_21_delta_damage",
        "using_rule_24"
      ]
    }
  },
