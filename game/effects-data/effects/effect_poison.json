{
  "schema": "chaosd6.effect/2",
  "id": "effect_poison",
  "name": "Poison",
  "version": "1.1.0",
  "source": {
    "collection": "effects",
    "version": "1.0.0"
  },
  "elements": [
    "elem_water",
    "elem_vitality"
  ],
  "cost": 2,
  "kind": "trap",
  "duration": "trap",
  "every": {
    "behaviour": "resolver",
    "note": "trap springs in peer.mjs (targeted, Σ max(0, 20 − stat) /10)"
  },
  "text": "Leave this card as a trap on your tile after casting.",
  "flags": {
    "damage": "delta",
    "scope": "target",
    "trap": {
      "trigger": "targeted",
      "mode": "damage"
    }
  },
  "card": {
    "name": "Poison",
    "tags": [
      "damage",
      "trap"
    ],
    "resources": {
      "source": "warlords3_battlecry",
      "wbc3_name": "Particle set green sparks",
      "wbc3_code": "EPA2",
      "wbc3_race": "Effects1",
      "match_reason": "green sparks + WBC3 Poison sound",
      "confidence": "medium",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Particle set green sparks/Particle set green sparks - idle [EPA2].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex"
        }
      },
      "sounds": {
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/Poison.wav",
            "usage": "sound effect on resolution / impact of the effect"
          }
        ]
      }
    },
    "data": {
      "effect_types": [
        "damage",
        "trap"
      ],
      "element_cost": [
        "elem_water",
        "elem_vitality"
      ],
      "text": "Leave this card as a trap on your tile after casting."
    },
    "logic": {
      "description": "Implemented (2026-10-29). Delta damage (Water, Vitality) to one enemy in contact — with nobody in reach the cast still completes — and the card stays face down under the caster as a trap (power 20 per element). It springs on the first enemy that targets the caster while they stand on it: Σ max(0, 20 − enemy stat) per element ÷10; then the card is discarded. User ruling 2026-10-30: the card, lying under me, goes back to MY discard pile when it springs.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "delta_damage",
          "description": "Rule 21 (pc): Σ over the cast elements of max(caster stat − defender stat, 0), ÷10, rounded half up; a Force Shield die is subtracted from the Σ before rounding (peer side).",
          "target": "target",
          "unit": "damage",
          "value": {
            "rule": [
              "rule_21_delta_damage",
              {
                "caster": {
                  "root": "caster"
                },
                "defender": {
                  "root": "defender"
                },
                "elements": {
                  "root": "elements"
                }
              }
            ]
          }
        },
        {
          "id": "trap_trigger",
          "description": "Springs on the first enemy whose reveal declares the trap owner as target while the owner stands on the trap tile; the card then goes to the discard pile.",
          "target": "tile",
          "unit": "trigger",
          "value": "targeted"
        },
        {
          "id": "trap_damage",
          "description": "When the trap springs: Σ over its elements of max(0, 20 − victim stat) ÷10 rounded half up (the same shields / zones / Void as a cast apply).",
          "target": "target",
          "unit": "damage",
          "value": {
            "round_div10": [
              {
                "sum": [
                  {
                    "map": [
                      {
                        "var": "elements"
                      },
                      {
                        "max0": [
                          {
                            "-": [
                              20,
                              {
                                "stat_of": [
                                  {
                                    "root": "target"
                                  },
                                  {
                                    "var": ""
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "trap_card_routing",
          "description": "User ruling 2026-10-30: a trap under its owner goes back to the OWNER's discard pile; a trap on an unoccupied tile (enter trigger) goes to the discard pile of the unit that dealt with it (sprang it, or a Cleric with someone on the tile). Library-generated traps only ever exist as that card for the one who dealt with them.",
          "target": "card",
          "unit": "discard_pile",
          "value": {
            "if": [
              {
                "==": [
                  {
                    "var": "trap.trigger"
                  },
                  "enter"
                ]
              },
              {
                "var": "trap.victim"
              },
              {
                "var": "trap.owner"
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_water (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_water"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_damage",
          "description": "effect_types keeps \"damage\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "damage"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "rule_21_delta_damage"
      ]
    }
  },
  "uses": [
    "std",
    "e2a"
  ],
  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "targets",
          "target",
          1,
          true
        ]
      },
      {
        "if": [
          {
            "!": [
              {
                "len": [
                  {
                    "var": "recipients"
                  }
                ]
              }
            ]
          },
          {
            "note": [
              "nobody in reach — the trap is set"
            ]
          }
        ]
      },
      {
        "map": [
          {
            "var": "recipients"
          },
          {
            "call": [
              "hit_with",
              {
                "var": "def"
              },
              [
                {
                  "obj": {
                    "kind": "main",
                    "sum": {
                      "call": [
                        "main_delta",
                        {
                          "var": "def"
                        }
                      ]
                    }
                  }
                }
              ],
              false,
              false
            ]
          },
          "def"
        ]
      },
      {
        "call": [
          "trap_self",
          "targeted",
          "damage"
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
