{
  "schema": "chaosd6.effect/2",
  "id": "effect_artifice",
  "name": "Artifice",
  "version": "1.1.0",
  "source": {
    "collection": "effects",
    "version": "1.0.0"
  },
  "elements": [
    "elem_earth"
  ],
  "cost": 1,
  "kind": "stat_token",
  "duration": "permanent",
  "every": {
    "behaviour": "none"
  },
  "text": "Put an element token in front of your deck as a permanent bonus until destroyed by damage or effect. Alt: put the element token over nearby or your location.",
  "flags": {
    "scope": "self",
    "statBonus": [
      "elem_earth"
    ],
    "tileTarget": true,
    "altTileToken": true
  },
  "card": {
    "name": "Artifice",
    "tags": [
      "permanent",
      "buff"
    ],
    "resources": {
      "source": "warlords3_battlecry",
      "wbc3_name": "Blue crystaldiamond icons",
      "wbc3_code": "EZ36",
      "wbc3_race": "Effects1",
      "match_reason": "crystal icon = crafted permanent token",
      "confidence": "medium",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Blue crystaldiamond icons/Blue crystaldiamond icons - idle [EZ36].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex"
        }
      },
      "sounds": {
        "spell": [
          {
            "path": "assets/Sounds/SoundFX/STEZ36.wav",
            "usage": "WBC3 spell-cast sound paired with the EZ effect; play when the effect is cast"
          }
        ],
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/Crystallize.wav",
            "usage": "sound effect on resolution / impact of the effect"
          }
        ]
      }
    },
    "data": {
      "effect_types": [
        "permanent",
        "point_buy"
      ],
      "element_cost": [
        "elem_earth"
      ],
      "text": "Put an element token in front of your deck as a permanent bonus until destroyed by damage or effect. Alt: put the element token over nearby or your location."
    },
    "rebalance_links": [
      "effect_potion_brew"
    ],
    "logic": {
      "description": "Reworked 2026-10-29. An Earth point-buy; the kept die becomes a bonus tile token on the left-clicked tile (mine or an adjacent one) of the element I clicked (general_ux_tokens; none clicked → a random element). Without a chosen tile the die lands as a +die token on my Matter stat as before. One token per element per tile — a bigger one replaces a smaller one of mine. Permanent until destroyed under Rule 24.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        },
        {
          "id": "self_only",
          "description": "The recipient is the caster (no target, or the caster right-clicked itself).",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                "==": [
                  {
                    "var": "target.id"
                  },
                  {
                    "var": "caster.id"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "tile_within_reach",
          "description": "The left-clicked tile lies within 1 hexes of the caster (general_ux_range_cast_target); none chosen → the engine picks (random / nearest).",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                "<=": [
                  {
                    "var": "dist"
                  },
                  1
                ]
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "stat_bonus_token",
          "description": "A point-buy on the caster elem_earth stat; the highest die becomes a +die token on the recipient stat behind elem_earth (permanent until destroyed by Rule 24).",
          "target": "caster",
          "unit": "stat",
          "value": {
            "var": "die"
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "Rule 24: an enemy point-buy die of the matching stat destroys this permanent when it is at least the token value behind the cast element.",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "max_of": [
                    {
                      "map": [
                        {
                          "filter": [
                            {
                              "var": "caster.tokens"
                            },
                            {
                              "==": [
                                {
                                  "var": "elem"
                                },
                                {
                                  "root": "elements.0"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "var": "value"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "tile_bonus_token",
          "description": "A chosen tile → a bonus tile token worth the kept die, of the clicked (else random) element.",
          "target": "tile",
          "unit": "token",
          "value": {
            "var": "die"
          }
        },
        {
          "id": "one_token_per_element",
          "description": "general_ux_tokens: one token per element on a tile — the new one stands only if it is bigger than the one already there.",
          "target": "tile",
          "unit": "rule",
          "value": {
            ">": [
              {
                "var": "token.value"
              },
              {
                "max_of": [
                  {
                    "map": [
                      {
                        "filter": [
                          {
                            "var": "tile.tokens"
                          },
                          {
                            "==": [
                              {
                                "var": "elem"
                              },
                              {
                                "root": "token.elem"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "var": "value"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_earth (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_earth"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_permanent",
          "description": "effect_types keeps \"permanent\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "permanent"
            ]
          }
        },
        {
          "id": "keeps_type_point_buy",
          "description": "effect_types keeps \"point_buy\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "point_buy"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "using_rule_24"
      ]
    }
  },
  "uses": [
    "std"
  ],
  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "targets",
          "self",
          1,
          false
        ]
      },
      {
        "set": [
          "tmp",
          null
        ]
      },
      {
        "if": [
          {
            "and": [
              {
                "===": [
                  {
                    "var": "cast.target.kind"
                  },
                  "tile"
                ]
              },
              {
                "<=": [
                  {
                    "hex_dist": [
                      {
                        "var": "my_tile"
                      },
                      {
                        "var": "cast.target.ref"
                      }
                    ]
                  },
                  1
                ]
              }
            ]
          },
          {
            "let": [
              {
                "el": {
                  "if": [
                    {
                      "in": [
                        {
                          "var": "cast.elem"
                        },
                        {
                          "all_elems": []
                        }
                      ]
                    },
                    {
                      "var": "cast.elem"
                    },
                    {
                      "at": [
                        {
                          "all_elems": []
                        },
                        {
                          "rng": [
                            "artifice",
                            10
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "let": [
                  {
                    "val": {
                      "call": [
                        "buy",
                        {
                          "call": [
                            "my_stat",
                            {
                              "var": "el"
                            }
                          ]
                        },
                        {
                          "cat": [
                            "artifice:",
                            {
                              "var": "el"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "seq": [
                      {
                        "if": [
                          {
                            ">": [
                              {
                                "var": "val"
                              },
                              0
                            ]
                          },
                          {
                            "emit": [
                              "tokens",
                              {
                                "obj": {
                                  "kind": "bonus",
                                  "elem": {
                                    "var": "el"
                                  },
                                  "value": {
                                    "var": "val"
                                  },
                                  "q": {
                                    "var": "cast.target.ref.q"
                                  },
                                  "r": {
                                    "var": "cast.target.ref.r"
                                  }
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "set": [
                          "tmp",
                          {
                            "var": "cast.target.ref"
                          }
                        ]
                      },
                      {
                        "set": [
                          "recipients",
                          []
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "if": [
          {
            "!": [
              {
                "var": "tmp"
              }
            ]
          },
          {
            "map": [
              {
                "var": "recipients"
              },
              {
                "call": [
                  "stat_token",
                  {
                    "var": "who"
                  },
                  "elem_earth",
                  1,
                  "bonus"
                ]
              },
              "who"
            ]
          }
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
