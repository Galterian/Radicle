                      },
                      {
                        "var": "me"
                      }
                    ]
                  },
                  "amount": {
                    "round_div10": [
                      {
                        "base_stat": [
                          {
                            "var": "me"
                          },
                          "vitality"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "map": [
          {
            "var": "recipients"
          },
          {
            "call": [
              "hit_with",
              {
                "var": "def"
              },
              [
                {
                  "obj": {
                    "kind": "main",
                    "sum": {
                      "call": [
                        "main_delta",
                        {
                          "var": "def"
                        }
                      ]
                    }
                  }
                }
              ],
              false,
              false
            ]
          },
          "def"
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
