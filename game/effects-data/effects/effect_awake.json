{
  "schema": "chaosd6.effect/1",
  "id": "effect_awake",
  "name": "Awake",
  "version": "1.1.0",
  "source": {"collection":"effects","version":"1.1.0"},
  "elements": ["elem_harmony"],
  "cost": 1,
  "kind": "surgery",
  "duration": "channel",
  "every": {"behaviour":"resolver","note":"∀: the permanent stays when the channel ends and lends the target's stat (peer.mjs awakeLend); channel ticks via cast._channel_tick"},
  "text": "Move around a terrain card, wall token, ally, or yourself. Channel: draw a Harmony token every action until contact.",
  "every_text": "Permanent — combine both Awakes into one permanent — add the target's Stat to your Stat.",
  "flags": {"tileTarget":true,"surgery":"awake","permanent":true,"channel":{"stop":"break"}},
  "uses": ["std","e2a","e2c"],
  "logic": {"seq": [
      {"call":["prelude"]},
      {"if":[{"bool":[{"var":"cast._channel_tick"}]},
        {"let":[{"st":{"call":["my_stat","elem_harmony"]}},
          {"let":[{"pb":{"point_buy":[{"var":"st"},"awake:elem_harmony"]}},
            {"seq":[
              {"emit":["rolls",{"obj":{"elem":"awake:elem_harmony","dice":{"var":"pb.dice"},"stat":{"var":"st"},"ok":{"!":[{"var":"pb.fail"}]}}}]},
              {"if":[{"and":[{"!":[{"var":"pb.fail"}]},{">":[{"var":"pb.value"},0]}]},{"emit":["tokens",{"obj":{"kind":"bonus","elem":"elem_harmony","value":{"var":"pb.value"},"q":{"var":"my_tile.q"},"r":{"var":"my_tile.r"}}}]}]},
              {"if":[{"var":"pb.fail"},{"note":["awake channel: the Harmony roll failed"]},{"note":["awake channel: Harmony token ",{"var":"pb.value"}]}]}]}]}]},
        {"seq":[
          {"if":[{"===":[{"str":[{"var":"cast.awake.kind"}]},{"var":"cast.awake.kind"}]},
            {"if":[{"and":[{"===":[{"var":"cast.awake.kind"},"unit"]},{"bool":[{"var":"cast.awake.who"}]}]},
              {"seq":[{"emit":["moves",{"obj":{"who":{"var":"cast.awake.who"},"q":{"var":"cast.awake.q"},"r":{"var":"cast.awake.r"},"reason":"awakened"}}]},
                      {"note":["awake moves ",{"var":"cast.awake.who"}," to (",{"var":"cast.awake.q"},",",{"var":"cast.awake.r"},") [",{"var":"cast.awake.how"},", gain ",{"var":"cast.awake.gain"},"]"]}]},
              {"if":[{"and":[{"===":[{"var":"cast.awake.kind"},"building"]},{"bool":[{"var":"cast.awake.from"}]}]},
                {"seq":[{"emit":["relocations",{"obj":{"kind":"building","owner":"world","id":{"cat":["bld:",{"var":"cast.awake.from.q"},",",{"var":"cast.awake.from.r"}]},"label":{"var":"cast.awake.label"},"by":{"var":"me"},"from":{"obj":{"q":{"var":"cast.awake.from.q"},"r":{"var":"cast.awake.from.r"}}},"q":{"var":"cast.awake.q"},"r":{"var":"cast.awake.r"}}}]},
                        {"note":["awake moves the ",{"var":"cast.awake.label"}," (",{"var":"cast.awake.from.q"},",",{"var":"cast.awake.from.r"},") to (",{"var":"cast.awake.q"},",",{"var":"cast.awake.r"},") [",{"var":"cast.awake.how"},", gain ",{"var":"cast.awake.gain"},"]"]}]},
                {"if":[{"and":[{"===":[{"var":"cast.awake.kind"},"wall"]},{"bool":[{"var":"cast.awake.reloc"}]},{"bool":[{"var":"cast.awake.from"}]}]},
                  {"seq":[{"emit":["relocations",{"var":"cast.awake.reloc"}]},
                          {"note":["awake moves the ",{"var":"cast.awake.label"}," (",{"var":"cast.awake.from.q"},",",{"var":"cast.awake.from.r"},") to (",{"var":"cast.awake.q"},",",{"var":"cast.awake.r"},") [",{"var":"cast.awake.how"},", gain ",{"var":"cast.awake.gain"},"]"]}]},
                  {"seq":[{"put":["status","fizzled"]},{"note":["awake: ",{"or":[{"var":"cast.awake.why"},"nothing can move"]}]}]}]}]}]},
            {"if":[{"call":["e2c_surgery_ok"]},{"call":["e2c_awake"]}]}]},
          {"if":[{"and":[{"!":[{"len":[{"out":"moves"}]}]},{"!":[{"len":[{"out":"relocations"}]}]},{"===":[{"out":"status"},"done"]}]},{"seq":[{"put":["status","fizzled"]},{"note":["awake needs a free tile within 10"]}]}]}]}]},
      {"call":["land_permanent"]},
      {"call":["channel_reg","break"]},
      {"call":["finish"]}
    ]}
}
