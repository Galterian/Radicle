    "logic": {
      "description": "Implemented 2026-11-17 (user ruling, supersedes the 2026-10-30 enemy bind). Units I kill hand their creature card to my archive (the killer = who dealt the dead unit the most damage that action, ties → smallest id). Possess: the reveal carries the archive creature I picked (UI 👁 in the archive; none picked → the strongest by Σ stats); the permanent (fixed power 6, destroyable by Rule 24 like any permanent) lands in MY holding and the creature enters next to me as my companion — my action card and target drive it (reveal proxy), my hero holds with Empty Posture. It ends when the permanent is destroyed (the creature leaves, its card back to my archive) or the creature dies (the permanent falls with it; its killer gets the creature card). Phylactery: Possess cast with no creature in my archive gives the Phylactery permanent instead; one click shatters, at the end of that action and with no roll, the best permanent of the NEAREST enemy within data.phylactery.reach hexes that holds one (class cards never): highest Rule 24 power, then a creature-holding one, then a hostile one, then id — judged by every peer from the same view; the Phylactery is spent. No enemy in reach or no permanent → it is shown inactive and the click does nothing.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "permanents_destroyed_alt",
          "description": "Phylactery (no creature in my archive): one enemy permanent shattered, no roll, on a click — the Phylactery is spent.",
          "target": "target",
          "unit": "permanents",
          "value": 1
        },
        {
          "id": "permanent_power",
          "description": "Rule 24 threshold of the permanent: fixed 6 (no placement die).",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "fixed_power_6",
              {}
            ]
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "Rule 24: an adjacent enemy emitting the matching stat destroys this permanent when their highest die is at least its power.",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "rule": [
                    "fixed_power_6",
                    {}
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "permanent_on_caster",
          "description": "The permanent lands in the caster's holding (possess_mode possess with an archive creature, else phylactery).",
          "target": "caster",
          "unit": "permanent",
          "value": 1
        },
        {
          "id": "possessor_drives",
          "description": "The caster's picked action and target are the archive creature's reveal (proxy); the caster's hero holds with Empty Posture.",
          "target": "target",
          "unit": "proxy",
          "value": {
            "var": "cast.proxy"
          }
        },
        {
          "id": "phylactery_reach",
          "description": "Phylactery target: the nearest enemy within this many hexes holding a non-class permanent; on it the highest-power permanent (creature holder, then hostile, then id on ties).",
          "target": "target",
          "unit": "hexes",
          "value": 2
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_vitality (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_vitality"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_permanent",
          "description": "effect_types keeps \"permanent\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "permanent"
            ]
          }
        },
        {
          "id": "keeps_type_point_buy",
          "description": "effect_types keeps \"point_buy\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "point_buy"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "fixed_power_6",
        "using_rule_24"
      ]
    }
  },
