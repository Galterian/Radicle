{
  "schema": "chaosd6.effect/1",
  "id": "effect_possess_phylactery",
  "name": "Possess / Phylactery",
  "version": "1.1.0",
  "source": {"collection":"effects","version":"1.1.0"},
  "elements": ["elem_vitality"],
  "cost": 1,
  "kind": "meta",
  "duration": "permanent",
  "every": {"behaviour":"none"},
  "text": "Possess: pick a creature you killed from your archive and play it while this permanent stands (your character stands still, Empty Posture / Empty Move). No creature in your archive: the Phylactery permanent instead — click it to destroy the most valuable permanent of the nearest enemy (inactive with no enemy or no permanent near).",
  "flags": {"permanent":true,"scope":"self","possess":true,"fixedPower":6},
  "uses": ["std","e2b"],
  "logic": {"seq": [
      {"call":["prelude"]},
      {"call":["targets","self",1,false]},
      {"let":[{"cid":{"var":"cast.possess.creature_id"},"ccard":{"var":"cast.possess.card_id"},"cname":{"var":"cast.possess.name"}},{"if":[{"and":[{"===":[{"str":[{"var":"cid"}]},{"var":"cid"}]},{"!==":[{"var":"cid"},""]}]},{"seq":[{"put":["possess",{"obj":{"creature":{"obj":{"creature_id":{"var":"cid"},"card_id":{"if":[{"===":[{"str":[{"var":"ccard"}]},{"var":"ccard"}]},{"var":"ccard"},null]},"name":{"if":[{"===":[{"str":[{"var":"cname"}]},{"var":"cname"}]},{"var":"cname"},null]}}}}}]},{"note":["possess ",{"var":"cid"}," from my archive"]}]},{"seq":[{"put":["possess",{"obj":{"phylactery":true}}]},{"note":["no creature in my archive — the Phylactery"]}]}]}]},
      {"if":[{"and":[{"===":[{"out":"status"},"done"]},{"!":[{"var":"cast._channel_tick"}]}]},{"emit":["permanents",{"obj":{"on":{"var":"me"},"id":{"var":"effect_id"}}}]}]},
      {"call":["finish"]}
    ]}
}
