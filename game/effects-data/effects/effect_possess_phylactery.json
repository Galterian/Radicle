  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "targets",
          "self",
          1,
          false
        ]
      },
      {
        "let": [
          {
            "cid": {
              "var": "cast.possess.creature_id"
            },
            "ccard": {
              "var": "cast.possess.card_id"
            },
            "cname": {
              "var": "cast.possess.name"
            }
          },
          {
            "if": [
              {
                "and": [
                  {
                    "===": [
                      {
                        "str": [
                          {
                            "var": "cid"
                          }
                        ]
                      },
                      {
                        "var": "cid"
                      }
                    ]
                  },
                  {
                    "!==": [
                      {
                        "var": "cid"
                      },
                      ""
                    ]
                  }
                ]
              },
              {
                "seq": [
                  {
                    "put": [
                      "possess",
                      {
                        "obj": {
                          "creature": {
                            "obj": {
                              "creature_id": {
                                "var": "cid"
                              },
                              "card_id": {
                                "if": [
                                  {
                                    "===": [
                                      {
                                        "str": [
                                          {
                                            "var": "ccard"
                                          }
                                        ]
                                      },
                                      {
                                        "var": "ccard"
                                      }
                                    ]
                                  },
                                  {
                                    "var": "ccard"
                                  },
                                  null
                                ]
                              },
                              "name": {
                                "if": [
                                  {
                                    "===": [
                                      {
                                        "str": [
                                          {
                                            "var": "cname"
                                          }
                                        ]
                                      },
                                      {
                                        "var": "cname"
                                      }
                                    ]
                                  },
                                  {
                                    "var": "cname"
                                  },
                                  null
                                ]
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  {
                    "note": [
                      "possess ",
                      {
                        "var": "cid"
                      },
                      " from my archive"
                    ]
                  }
                ]
              },
              {
                "seq": [
                  {
                    "put": [
                      "possess",
                      {
                        "obj": {
                          "phylactery": true
                        }
                      }
                    ]
                  },
                  {
                    "note": [
                      "no creature in my archive — the Phylactery"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "if": [
          {
            "and": [
              {
                "===": [
                  {
                    "out": "status"
                  },
                  "done"
                ]
              },
              {
                "!": [
                  {
                    "var": "cast._channel_tick"
                  }
                ]
              }
            ]
          },
          {
            "emit": [
              "permanents",
              {
                "obj": {
                  "on": {
                    "var": "me"
                  },
                  "id": {
                    "var": "effect_id"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
