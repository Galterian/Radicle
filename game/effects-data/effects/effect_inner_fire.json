{
  "schema": "chaosd6.effect/2",
  "id": "effect_inner_fire",
  "name": "Inner Fire",
  "version": "1.3.0",
  "source": {
    "collection": "effects",
    "version": "1.1.0"
  },
  "elements": [
    "elem_vitality",
    "elem_fire"
  ],
  "cost": 2,
  "kind": "permanent",
  "duration": "permanent",
  "every": {
    "behaviour": "resolver",
    "note": "a 1-damage hit of the holder becomes 2 (peer.mjs)"
  },
  "text": "When you make one non-effect damage, you deal two damage instead.",
  "flags": {
    "permanent": true
  },
  "bot": {
    "tags": [
      "bruiser",
      "brute",
      "dragon-kin"
    ],
    "names": [
      "ember|hellkite|dragon|kite"
    ],
    "defence": true
  },
  "standing": {
    "combat_out": {
      "if": [
        {
          "===": [
            {
              "var": "dmg"
            },
            1
          ]
        },
        2,
        {
          "var": "dmg"
        }
      ]
    }
  },
  "card": {
    "name": "Inner Fire",
    "tags": [
      "permanent",
      "buff"
    ],
    "resources": {
      "source": "warlords3_battlecry",
      "wbc3_name": "Orange glowing rings",
      "wbc3_code": "EZ28",
      "wbc3_race": "Effects1",
      "match_reason": "orange glow around an empowered fighter",
      "confidence": "medium",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Orange glowing rings/Orange glowing rings - idle [EZ28].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex",
          "blend": "additive"
        }
      },
      "sounds": {
        "spell": [
          {
            "path": "assets/Sounds/SoundFX/STEZ28.wav",
            "usage": "WBC3 spell-cast sound paired with the EZ effect; play when the effect is cast"
          }
        ],
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/Fire.wav",
            "usage": "sound effect on resolution / impact of the effect"
          }
        ]
      }
    },
    "data": {
      "effect_types": [
        "permanent"
      ],
      "element_cost": [
        "elem_vitality",
        "elem_fire"
      ],
      "text": "When you make one non-effect damage, you deal two damage instead."
    },
    "logic": {
      "description": "Implemented permanent. While it stands in front of the caster deck, any non-effect damage of exactly 1 the caster deals (Attack, matrix edges) becomes 2. Placed with a point-buy die as its Rule 24 power. No ∀ bonus.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "non_effect_damage_doubled",
          "description": "A non-effect hit of 1 becomes 2 while the permanent stands.",
          "target": "caster",
          "unit": "damage",
          "value": 2
        },
        {
          "id": "permanent_power",
          "description": "Rule 12: the permanent is placed with a point-buy die (re-rolled until the sum fits); that die is its power under Rule 24.",
          "target": "caster",
          "unit": "die",
          "value": {
            "var": "die"
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "Rule 24: an enemy point-buy die of the matching stat destroys this permanent when it is at least the token value behind the cast element.",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "max_of": [
                    {
                      "map": [
                        {
                          "filter": [
                            {
                              "var": "caster.tokens"
                            },
                            {
                              "==": [
                                {
                                  "var": "elem"
                                },
                                {
                                  "root": "elements.0"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "var": "value"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_fire (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_fire"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_permanent",
          "description": "effect_types keeps \"permanent\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "permanent"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "using_rule_24"
      ]
    }
  },
  "uses": [
    "std",
    "e2a"
  ],
  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "land_permanent"
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
