{
  "schema": "chaosd6.effect/2",
  "id": "effect_summoning",
  "name": "Summoning",
  "version": "1.2.0",
  "source": {
    "collection": "effects",
    "version": "1.0.0"
  },
  "elements": [
    "elem_souls"
  ],
  "cost": 1,
  "kind": "summon",
  "duration": "cast",
  "every": {
    "behaviour": "resolver",
    "note": "∀ binds a creature in view (cast.summon.bind, prepared by peer.mjs prepareSummon)"
  },
  "text": "Perform summoning of your archived creature or Library's top creature until Stat spent is rounded to the creature's Stats. On destruction: creature returns to your archives.",
  "every_text": "Summon unknown creature from the tileset.",
  "flags": {
    "permanent": true,
    "statBuy": true,
    "fixedPower": 6,
    "summon": {
      "kind": "library",
      "label": "Summoning"
    }
  },
  "card": {
    "name": "Summoning",
    "tags": [
      "permanent",
      "stat_buy",
      "ally"
    ],
    "resources": {
      "source": "warlords3_battlecry",
      "wbc3_name": "Spell effect tall whiteblue flame columns (summon pillar)",
      "wbc3_code": "EZ09",
      "wbc3_race": "Effects1",
      "match_reason": "WBC3 summon pillar effect",
      "confidence": "high",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/SummonPillar [EZ09]/SummonPillar - idle [EZ09].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex",
          "blend": "additive"
        }
      },
      "sounds": {
        "spell": [
          {
            "path": "assets/Sounds/SoundFX/STEZ09.wav",
            "usage": "WBC3 spell-cast sound paired with the EZ effect; play when the effect is cast"
          }
        ],
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/Magic.wav",
            "usage": "sound effect on resolution / impact of the effect"
          }
        ]
      }
    },
    "data": {
      "effect_types": [
        "permanent",
        "stat_buy",
        "channeling"
      ],
      "element_cost": [
        "elem_souls"
      ],
      "every_bonus": "Summon unknown creature from the tileset.",
      "permanent_power": 6,
      "text": "Perform summoning of your archived creature or Library's top creature until Stat spent is rounded to the creature's Stats. On destruction: creature returns to your archives."
    },
    "rebalance_links": [
      "effect_resurrect_death_ward",
      "effect_elementals_air"
    ],
    "logic": {
      "description": "Implemented stat buy (channeling). Summons the caster archived creature (or the Library top creature); the need is that creature stat sum (cast.need). Every emission banks the caster stat behind the element going out (card elements round-robin) until the bank is at least the need (creature stat sum); no dice, so nothing fails — a low stat only takes longer. The creature appears as the caster ally on completion and the card stays as a permanent with FIXED power 6 (Rule 24: the destroyer needs a 6); on destruction the creature vanishes and its card goes to the owner archive. The ∀ double cast instead binds an unknown creature in view: it must still be alive, visible and within 10 hexes at completion, otherwise the cast fizzles.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "stat_buy_bank_this_emission",
          "description": "Every emission banks the caster stat behind the element going out (card elements round-robin: emission k banks element k mod |elements|); no dice, nothing fails.",
          "target": "caster",
          "unit": "stat",
          "value": {
            "stat_of": [
              {
                "var": "caster"
              },
              {
                "var": {
                  "cat": [
                    "elements.",
                    {
                      "%": [
                        {
                          "max0": [
                            {
                              "-": [
                                {
                                  "var": "cast.step"
                                },
                                1
                              ]
                            }
                          ]
                        },
                        {
                          "max": [
                            1,
                            {
                              "count": [
                                {
                                  "var": "elements"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "stat_buy_paid",
          "description": "The cast completes once the bank is at least the need (the creature stat sum).",
          "target": "caster",
          "unit": "stat",
          "value": {
            "rule": [
              "stat_buy_paid",
              {
                "bank": {
                  "var": "cast.bank"
                },
                "need": {
                  "var": "cast.need"
                }
              }
            ]
          }
        },
        {
          "id": "emissions_needed",
          "description": "Upper bound of emissions at the caster current stats: need ÷ the smallest stat the card elements bank, rounded up (the k/n cast length shown in the UI).",
          "target": "caster",
          "unit": "actions",
          "value": {
            "rule": [
              "stat_buy_emissions_needed",
              {
                "need": {
                  "var": "cast.need"
                },
                "caster": {
                  "root": "caster"
                },
                "elements": {
                  "root": "elements"
                }
              }
            ]
          }
        },
        {
          "id": "permanent_power",
          "description": "Stat-buy summons are always cast with tokens of value 6 (fixed power, no die rolled at placement).",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "fixed_power_6",
              {}
            ]
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "Rule 24 with fixed power: the destroyer needs a 6. On destruction the creature vanishes and its card goes to the owner archive.",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "rule": [
                    "fixed_power_6",
                    {}
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "bind_reach_every",
          "description": "Hex reach within which the ∀ bind target must still stand at completion.",
          "target": "target",
          "unit": "hexes",
          "value": 10
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_souls (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_souls"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_permanent",
          "description": "effect_types keeps \"permanent\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "permanent"
            ]
          }
        },
        {
          "id": "keeps_type_stat_buy",
          "description": "effect_types keeps \"stat_buy\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "stat_buy"
            ]
          }
        },
        {
          "id": "permanent_power_fixed_6",
          "description": "permanent_power, when given, stays 6 (fixed power of the stat-buy summons).",
          "assert": {
            "or": [
              {
                "==": [
                  {
                    "var": "proposal.data.permanent_power"
                  },
                  null
                ]
              },
              {
                "==": [
                  {
                    "var": "proposal.data.permanent_power"
                  },
                  6
                ]
              }
            ]
          }
        },
        {
          "id": "keeps_every_bonus",
          "description": "The ∀ double-cast bonus text stays present (the engine unlocks it on a Rule 23 chained cast).",
          "assert": {
            "==": [
              {
                "typeof": [
                  {
                    "var": "proposal.data.every_bonus"
                  }
                ]
              },
              "string"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "fixed_power_6",
        "stat_buy_emissions_needed",
        "stat_buy_paid",
        "using_rule_24"
      ]
    }
  },
  "uses": [
    "std",
    "e2b"
  ],
  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "stat_buy",
          false
        ]
      },
      {
        "call": [
          "land_permanent"
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
