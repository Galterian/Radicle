    "logic": {
      "description": "Implemented. When the last Fire is emitted the cast deals Rule 21 delta damage (Σ per element max(caster Matter − defender Matter, 0) ÷10 rounded half up) to one enemy in contact (right-clicked, else the enemy the cast hurts most), and buys a fire token on the target tile with a Matter point-buy: if the target did not move off this action the token burns it at once for round(die ÷10) and is consumed, otherwise it stays on the tile and burns the first unit that steps on it. A failed token roll turns the whole cast into a retry (re-emit the last element). Under Aura the hit becomes every adjacent enemy, under Aura ∀ every enemy within 10. A ∀ double cast is one chained cast of 3 emissions with no extra bonus (no every_bonus on the card). The \"permanent\" type covers the tile token, not a card in front of the deck.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        },
        {
          "id": "target_in_reach",
          "description": "No declared target (the engine picks the enemy the cast hurts most within 1) or the right-clicked target is within 1 hex; through an Aura ∀ the reach is the whole view (10).",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                "if": [
                  {
                    "var": "cast.aura"
                  },
                  {
                    "rule": [
                      "in_view",
                      {
                        "dist": {
                          "var": "dist"
                        },
                        "radius": 10
                      }
                    ]
                  },
                  {
                    "rule": [
                      "in_contact",
                      {
                        "dist": {
                          "var": "dist"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "target_is_enemy",
          "description": "A declared target must be an enemy (exactly one side is npc_b); without one the engine aims at an enemy itself.",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                "rule": [
                  "is_enemy",
                  {
                    "a_alliance": {
                      "var": "caster.alliance"
                    },
                    "b_alliance": {
                      "var": "target.alliance"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "target_alive",
          "description": "A declared target must still be alive (life > 0); dead units are skipped.",
          "when": {
            "or": [
              {
                "==": [
                  {
                    "var": "target"
                  },
                  null
                ]
              },
              {
                ">": [
                  {
                    "var": "target.life"
                  },
                  0
                ]
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "delta_damage",
          "description": "Rule 21 (pc): Σ over the cast elements of max(caster stat − defender stat, 0), ÷10, rounded half up; a Force Shield die is subtracted from the Σ before rounding (peer side).",
          "target": "target",
          "unit": "damage",
          "value": {
            "rule": [
              "rule_21_delta_damage",
              {
                "caster": {
                  "root": "caster"
                },
                "defender": {
                  "root": "defender"
                },
                "elements": {
                  "root": "elements"
                }
              }
            ]
          }
        },
        {
          "id": "fire_token_value",
          "description": "The fire token value: the highest die of a Matter point-buy made at completion (Rule 20); it deals round(value ÷10) when consumed.",
          "target": "tile",
          "unit": "tokens",
          "value": {
            "var": "die"
          }
        },
        {
          "id": "fire_token_damage",
          "description": "Damage the fire token deals to the unit it burns (immediately to the target, or later to whoever steps on it).",
          "target": "tile",
          "unit": "damage",
          "value": {
            "round_div10": [
              {
                "var": "die"
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_fire (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_fire"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_damage",
          "description": "effect_types keeps \"damage\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "damage"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "in_contact",
        "in_view",
        "is_enemy",
        "rule_21_delta_damage"
      ]
    }
  },
