                                      },
                                      {
                                        "note": [
                                          "banish ",
                                          {
                                            "var": "tgt"
                                          },
                                          " → (",
                                          {
                                            "var": "t.q"
                                          },
                                          ",",
                                          {
                                            "var": "t.r"
                                          },
                                          "), ",
                                          {
                                            "hex_dist": [
                                              {
                                                "var": "my_tile"
                                              },
                                              {
                                                "var": "t"
                                              }
                                            ]
                                          },
                                          " away"
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
