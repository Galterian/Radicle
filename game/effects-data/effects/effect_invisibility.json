{
  "schema": "chaosd6.effect/2",
  "id": "effect_invisibility",
  "name": "Invisibility",
  "version": "1.3.0",
  "source": {
    "collection": "effects",
    "version": "1.1.0"
  },
  "elements": [
    "elem_fire",
    "elem_space"
  ],
  "cost": 2,
  "kind": "permanent",
  "duration": "permanent",
  "every": {
    "behaviour": "resolver",
    "note": "∀ 'until you deal damage' is handled by peer.mjs (invisibleNow)"
  },
  "text": "Point-buy permanent: put it in your permanents holder. While it stands you may move around the map and you are not visible to enemies (only to your allies, other invisible characters, the Vision effect and the Cleric's class skill): they cannot target you and monsters do not see you. Once you start casting a spell, or use Attack or Block, the permanent is destroyed. Untargeted area effects (Meteor Shower) still reach you.",
  "every_text": "Permanent until you make damage.",
  "flags": {
    "permanent": true,
    "hides": true
  },
  "bot": {
    "ai": false
  },
  "standing": {
    "breaks": {
      "if": [
        {
          "var": "every"
        },
        {
          "bool": {
            "var": "dealt_damage"
          }
        },
        {
          "some": [
            {
              "var": "plays"
            },
            {
              "let": [
                {
                  "codes": {
                    "if": [
                      {
                        "and": [
                          {
                            "is_array": {
                              "var": "p.trance"
                            }
                          },
                          {
                            "len": {
                              "var": "p.trance"
                            }
                          }
                        ]
                      },
                      {
                        "var": "p.trance"
                      },
                      [
                        {
                          "var": "p.action"
                        }
                      ]
                    ]
                  },
                  "eff": {
                    "??": [
                      {
                        "var": "p.effect_id"
                      },
                      {
                        "var": "p.effect.effect_id"
                      },
                      null
                    ]
                  }
                },
                {
                  "or": [
                    {
                      "some": [
                        {
                          "var": "codes"
                        },
                        {
                          "in": [
                            {
                              "var": "c"
                            },
                            {
                              "merge": [
                                [
                                  "A",
                                  "B"
                                ],
                                {
                                  "var": "extra_codes"
                                }
                              ]
                            }
                          ]
                        },
                        "c"
                      ]
                    },
                    {
                      "and": [
                        {
                          "bool": {
                            "var": "eff"
                          }
                        },
                        {
                          "!==": [
                            {
                              "var": "eff"
                            },
                            {
                              "var": "self"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "p"
          ]
        }
      ]
    }
  },
  "card": {
    "name": "Invisibility",
    "tags": [
      "permanent",
      "stealth"
    ],
    "resources": {
      "source": "warlords3_battlecry",
      "wbc3_name": "Grey arc sweeps",
      "wbc3_code": "EZ66",
      "wbc3_race": "Effects1",
      "match_reason": "faint grey sweeps fading the hero out",
      "confidence": "low",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Grey arc sweeps/Grey arc sweeps - idle [EZ66].png",
          "usage": "effect animation strip (cols = frames; grid in assets/frames.json), play once at the target hex"
        }
      },
      "sounds": {
        "fx": [
          {
            "path": "assets/Sounds/SoundFX/Fade.wav",
            "usage": "sound effect on resolution / impact of the effect"
          }
        ]
      }
    },
    "data": {
      "effect_types": [
        "permanent"
      ],
      "element_cost": [
        "elem_fire",
        "elem_space"
      ],
      "every_bonus": "Permanent until you make damage.",
      "text": "Point-buy permanent: put it in your permanents holder. While it stands you may move around the map and you are not visible to enemies (only to your allies, other invisible characters, the Vision effect and the Cleric's class skill): they cannot target you and monsters do not see you. Once you start casting a spell, or use Attack or Block, the permanent is destroyed. Untargeted area effects (Meteor Shower) still reach you.",
      "hidden_from": "enemies",
      "breaks_on": [
        "attack",
        "block",
        "cast"
      ],
      "area_hits": true
    },
    "rebalance_links": [
      "effect_phantom",
      "class_rogue",
      "class_cleric"
    ],
    "logic": {
      "description": "Implemented point-buy permanent (user ruling 2026-11-14). Lands in the caster's permanents holder with a point-buy die (Rule 12, its Rule 24 power). While it stands the caster is hidden from ENEMIES (allies still see it, drawn faded; another invisible unit sees it): enemy UIs drop it from map, roster, hover and click targets; enemy casts and autotargets (Rule 15, Counter Spell, Reaver, Battle Trance, combo, targeted skills, Rule 24 destroy) skip it; Attacks, aimed effects, traps and fire tokens do not hurt it; monsters neither wake on it nor chase it. It is destroyed the moment the caster uses Attack or Block (a Battle Trance A/B option, a Reaver EP/EM fighting as Attack) or starts casting any other effect (any emission, instants and bonus plans included) — and it is already seen in that action. Moving, a bare Posture, Empty actions, skills and Rule 24 destroy emissions keep it. Untargeted area damage (Meteor Shower) still hits it. With the ∀ double cast it holds (hidden even while fighting) until the caster deals damage.",
      "prerequisites": [
        {
          "id": "action_may_cast",
          "description": "Only Posture / Empty Posture emit the elements of a non-instant cast (Rule 20).",
          "when": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "var": "caster.action"
                },
                "is_instant": false
              }
            ]
          }
        },
        {
          "id": "elements_not_disabled",
          "description": "No element of the cast is barred for the caster by a fired Disable (Rule 20 pc override).",
          "when": {
            "rule": [
              "elements_not_disabled",
              {
                "elements": {
                  "root": "elements"
                },
                "disabled": {
                  "root": "caster.disabled_elems"
                }
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "permanent_power",
          "description": "Rule 12: the permanent is placed with a point-buy die (re-rolled until the sum fits); that die is its power under Rule 24.",
          "target": "caster",
          "unit": "die",
          "value": {
            "var": "die"
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "Rule 24: an enemy point-buy die of the matching stat destroys this permanent when it is at least the token value behind the cast element.",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "max_of": [
                    {
                      "map": [
                        {
                          "filter": [
                            {
                              "var": "caster.tokens"
                            },
                            {
                              "==": [
                                {
                                  "var": "elem"
                                },
                                {
                                  "root": "elements.0"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "var": "value"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "hidden_from_enemies",
          "description": "1 while the permanent stands and this action's reveal does not break it (invisibility_breaks); ∀: 1 until the caster deals damage. Enemies cannot see / target it; allies and other invisible units can.",
          "target": "caster",
          "unit": "flag",
          "value": {
            "if": [
              {
                "or": [
                  {
                    "var": "cast.every"
                  },
                  {
                    "!": [
                      {
                        "rule": [
                          "invisibility_breaks",
                          {
                            "action": {
                              "var": "caster.action"
                            },
                            "trance": {
                              "var": "caster.trance"
                            },
                            "effect_id": {
                              "var": "caster.effect_id"
                            },
                            "reaver": {
                              "var": "caster.is_reaver"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1,
              0
            ]
          }
        },
        {
          "id": "ends_on",
          "description": "Own reveals that end it: the first one that uses Attack / Block or emits for another effect (invisibility_breaks); ∀: the first damage dealt.",
          "target": "caster",
          "unit": "actions",
          "value": 1
        }
      ],
      "validation": [
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_fire (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_fire"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_keeps_key_element",
          "description": "element_cost stays non-empty and still carries elem_space (the element family that defines the effect).",
          "assert": {
            "and": [
              {
                ">=": [
                  {
                    "count": [
                      {
                        "var": "proposal.data.element_cost"
                      }
                    ]
                  },
                  1
                ]
              },
              {
                "includes": [
                  {
                    "var": "proposal.data.element_cost"
                  },
                  "elem_space"
                ]
              }
            ]
          }
        },
        {
          "id": "cost_count_within_one",
          "description": "The number of elements stays within ±1 of the canonical cost.",
          "assert": {
            "<=": [
              {
                "abs": [
                  {
                    "-": [
                      {
                        "count": [
                          {
                            "var": "proposal.data.element_cost"
                          }
                        ]
                      },
                      {
                        "count": [
                          {
                            "var": "entry.data.element_cost"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              1
            ]
          }
        },
        {
          "id": "keeps_type_permanent",
          "description": "effect_types keeps \"permanent\".",
          "assert": {
            "includes": [
              {
                "var": "proposal.data.effect_types"
              },
              "permanent"
            ]
          }
        },
        {
          "id": "keeps_every_bonus",
          "description": "The ∀ double-cast bonus text stays present (the engine unlocks it on a Rule 23 chained cast).",
          "assert": {
            "==": [
              {
                "typeof": [
                  {
                    "var": "proposal.data.every_bonus"
                  }
                ]
              },
              "string"
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "elements_not_disabled",
        "invisibility_breaks",
        "using_rule_24"
      ]
    }
  },
  "uses": [
    "std"
  ],
  "logic": {
    "seq": [
      {
        "call": [
          "prelude"
        ]
      },
      {
        "call": [
          "land_permanent"
        ]
      },
      {
        "call": [
          "finish"
        ]
      }
    ]
  }
}
