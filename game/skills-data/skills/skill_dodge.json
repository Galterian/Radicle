    "rebalance_links": [
      "skill_bluff"
    ],
    "logic": {
      "description": "Instant riding on a Move card (or an empty action). One point comes off the total combat damage the caster takes this action: one hit is reduced by 1, not one per attacker. Effect damage is not reduced. Rule 8 pc override: returns to hand when the caster took no combat damage.",
      "prerequisites": [
        {
          "id": "rides_on_move",
          "description": "The caster's action is Move (or an empty action, which carries Move skills).",
          "when": {
            "in": [
              {
                "var": "caster.action"
              },
              [
                "M",
                "EM",
                "EP"
              ]
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "combat_damage_prevented",
          "description": "1 when any combat damage would land on the caster this action, else 0 (never more than 1 in total).",
          "target": "caster",
          "unit": "damage",
          "value": {
            "min": [
              1,
              {
                "max0": [
                  {
                    "var": "outcome.combat_damage_taken"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "rule_8_return_to_hand",
          "description": "Rule 8 pc override: the card returns to hand when the round gave no benefit.",
          "target": "caster",
          "unit": "cards",
          "value": {
            "rule": [
              "rule_8_instant_returns",
              {
                "took_with": {
                  "var": "outcome.took_with"
                },
                "took_without": {
                  "var": "outcome.took_without"
                },
                "dealt_with": {
                  "var": "outcome.dealt_with"
                },
                "dealt_without": {
                  "var": "outcome.dealt_without"
                }
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "action_type_unchanged",
          "description": "Stays a Move skill.",
          "assert": {
            "==": [
              {
                "var": "proposal.data.action_type"
              },
              {
                "var": "entry.data.action_type"
              }
            ]
          }
        },
        {
          "id": "is_permanent_unchanged",
          "description": "Remains an instant.",
          "assert": {
            "==": [
              {
                "!!": {
                  "var": "proposal.data.is_permanent"
                }
              },
              {
                "!!": {
                  "var": "entry.data.is_permanent"
                }
              }
            ]
          }
        },
        {
          "id": "point_buy_stat_valid",
          "description": "point_buy_stat is null, 'any' or one of the four stats.",
          "assert": {
            "or": [
              {
                "==": [
                  {
                    "var": "proposal.data.point_buy_stat"
                  },
                  null
                ]
              },
              {
                "in": [
                  {
                    "var": "proposal.data.point_buy_stat"
                  },
                  [
                    "any",
                    "stat_vitality",
                    "stat_world",
                    "stat_matter",
                    "stat_will",
                    "vitality",
                    "world",
                    "matter",
                    "will"
                  ]
                ]
              }
            ]
          }
        }
      ],
      "references": [
        "rule_8_instant_returns"
      ]
