      "match_reason": "white protective rings",
      "confidence": "medium",
      "wbc3_name": "Spell effect white rings",
      "wbc3_code": "EZ04",
      "wbc3_race": "Effects1",
      "sprites": {
        "effect": {
          "path": "assets/Sprites/Effects/Effects1/Spell effect white rings/Spell effect white rings - idle [EZ04].png",
          "usage": "marker/animation strip shown on the skill target hex (cols = frames)"
        }
      },
