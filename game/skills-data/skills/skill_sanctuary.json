            "path": "assets/Sounds/SoundFX/Sparkles.wav",
            "usage": "play when the skill resolves (pick randomly if several)"
          }
        ]
      }
    },
    "data": {
      "action_type": "B",
      "is_permanent": true,
      "point_buy_stat": "any",
      "text": "Permanent. While it stands you, any permanent and any token you control (besides Sanctuary) are invincible as long as you only move around or rest (Move, Empty Move, Empty Posture): you can reposition and prepare your hand over the next turns. It ends as soon as you perform any other action (Attack, Block, Posture), play a skill or emit (an effect cast or a Rule 24 destroy) — in that action you are no longer protected."
    },
    "rebalance_links": [
      "skill_force_shield",
      "effect_the_void"
    ],
    "logic": {
      "description": "Permanent skill played with a Block card; point_buy_stat 'any' means the placement die is rolled against the caster's highest stat. While held (user ruling 2026-11-16: 'move around and prepare your hand in the next turns being invincible') the holder takes no combat and no effect damage as long as it only moves or rests — Move, Empty Move, Empty Posture, with no skill (a building's free skill excepted), no effect emission and no Rule 24 destroy emission. Any other action (Attack, Block, Posture, a Battle Trance option among them), a skill or an emission ends it: unprotected in that action, the permanent leaves the holding afterwards. Protection of the holder's permanents / tokens is not modelled. Destroyable under Rule 24 by a die >= its power.",
      "prerequisites": [
        {
          "id": "rides_on_block",
          "description": "The caster's action this turn is a Block card.",
          "when": {
            "in": [
              {
                "var": "caster.action"
              },
              [
                "B"
              ]
            ]
          }
        },
        {
          "id": "not_already_held",
          "description": "The permanent is not already in the caster's holding.",
          "when": {
            "!": {
              "includes": [
                {
                  "var": "caster.permanents"
                },
                "skill_sanctuary"
              ]
            }
          }
        }
      ],
      "effects": [
        {
          "id": "placement_dice",
          "description": "Number of d6 the placement point-buy rolls against the caster's highest stat ('any').",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "point_buy_dice_count",
              {
                "stat": {
                  "max": [
                    {
                      "var": "caster.stats.vitality"
                    },
                    {
                      "var": "caster.stats.world"
                    },
                    {
                      "var": "caster.stats.matter"
                    },
                    {
                      "var": "caster.stats.will"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "invincible_this_action",
          "description": "True while the holder only moves or rests: Move / Empty Move / Empty Posture, no skill, no emission.",
          "target": "caster",
          "unit": "damage",
          "value": {
            "and": [
              {
                "in": [
                  {
                    "var": "caster.action"
                  },
                  [
                    "M",
                    "EM",
                    "EP"
                  ]
                ]
              },
              {
                "!": {
                  "var": "caster.skill_played"
                }
              },
              {
                "!": {
                  "var": "caster.emits"
                }
              }
            ]
          }
        },
        {
          "id": "leaves_holding",
          "description": "The permanent is removed after an action that does not keep it (Attack, Block, Posture, a skill, an emission).",
          "target": "caster",
          "unit": "tokens",
          "value": {
            "!": {
              "and": [
                {
                  "in": [
                    {
                      "var": "caster.action"
                    },
                    [
                      "M",
                      "EM",
                      "EP"
                    ]
                  ]
                },
                {
                  "!": {
                    "var": "caster.skill_played"
                  }
                },
                {
                  "!": {
                    "var": "caster.emits"
                  }
                }
              ]
            }
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "A Rule 24 point-buy die destroys the permanent when it reaches the placement power.",
          "target": "caster",
          "unit": "tokens",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "var": "caster.perm_power.skill_sanctuary"
                }
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "action_type_unchanged",
          "description": "Stays a Block skill.",
          "assert": {
            "==": [
              {
                "var": "proposal.data.action_type"
              },
              {
                "var": "entry.data.action_type"
              }
            ]
          }
        },
        {
          "id": "stays_permanent",
          "description": "Remains a permanent.",
          "assert": {
            "==": [
              {
                "!!": {
                  "var": "proposal.data.is_permanent"
                }
              },
              {
                "!!": {
                  "var": "entry.data.is_permanent"
                }
              }
            ]
          }
        },
        {
          "id": "point_buy_stat_valid",
          "description": "A permanent needs a point-buy stat: 'any' or one of the four stats.",
          "assert": {
            "in": [
              {
                "var": "proposal.data.point_buy_stat"
              },
              [
                "any",
                "stat_vitality",
                "stat_world",
                "stat_matter",
                "stat_will",
                "vitality",
                "world",
                "matter",
                "will"
              ]
            ]
          }
        }
      ],
      "references": [
        "point_buy_dice_count",
        "using_rule_24"
      ]
    }
  }
}
