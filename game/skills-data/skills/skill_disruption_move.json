    "data": {
      "action_type": "M",
      "is_permanent": false,
      "point_buy_stat": null,
      "text": "The enemy cannot use Posture; any Empty Posture is always played as Empty Move (enemy cannot emit non-instant effects): their Posture or Empty Posture becomes an Empty Move that goes nowhere and emits nothing — a cast in progress is interrupted."
    },
    "rebalance_links": [
      "skill_ranged_weapon"
    ],
    "logic": {
      "description": "Instant riding on a Move card (also Empty Move / Empty Posture per the pc implementation) against an enemy target. Paper text implemented (user ruling 2026-11-16): the enemy cannot use Posture — a declared Posture is negated (card and riding instants back to their hand) — and any Empty Posture is always played as Empty Move: either way the target plays an Empty Move that goes nowhere and emits nothing, so a non-instant effect it was emitting is voided and a cast in progress is interrupted (Rule 19); instants still go out. Judged by whether it did its job (negated a Posture or stopped an emission); otherwise it returns to hand.",
      "prerequisites": [
        {
          "id": "rides_on_move",
          "description": "The caster's action is Move (or an empty action, which carries Move skills).",
          "when": {
            "in": [
              {
                "var": "caster.action"
              },
              [
                "M",
                "EM",
                "EP"
              ]
            ]
          }
        },
        {
          "id": "enemy_target",
          "description": "The target is an enemy unit.",
          "when": {
            "rule": [
              "is_enemy",
              {
                "a_alliance": {
                  "var": "caster.alliance"
                },
                "b_alliance": {
                  "var": "target.alliance"
                }
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "target_action_after",
          "description": "Posture and Empty Posture become Empty Move; anything else unchanged.",
          "target": "target",
          "unit": "actions",
          "value": {
            "if": [
              {
                "in": [
                  {
                    "var": "target.action"
                  },
                  [
                    "P",
                    "EP"
                  ]
                ]
              },
              "EM",
              {
                "var": "target.action"
              }
            ]
          }
        },
        {
          "id": "target_may_cast_non_instant",
          "description": "Whether the target may still emit a non-instant effect after the disruption (an Empty Move emits nothing).",
          "target": "target",
          "unit": "actions",
          "value": {
            "rule": [
              "action_can_cast_non_instant",
              {
                "action": {
                  "if": [
                    {
                      "in": [
                        {
                          "var": "target.action"
                        },
                        [
                          "P",
                          "EP"
                        ]
                      ]
                    },
                    "EM",
                    {
                      "var": "target.action"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "rule_8_return_to_hand",
          "description": "Rule 8 pc override: the card returns to hand when the round gave no benefit.",
          "target": "caster",
          "unit": "cards",
          "value": {
            "rule": [
              "rule_8_instant_returns",
              {
                "took_with": {
                  "var": "outcome.took_with"
                },
                "took_without": {
                  "var": "outcome.took_without"
                },
                "dealt_with": {
                  "var": "outcome.dealt_with"
                },
                "dealt_without": {
                  "var": "outcome.dealt_without"
                }
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "action_type_unchanged",
          "description": "Stays a Move skill.",
          "assert": {
            "==": [
              {
                "var": "proposal.data.action_type"
              },
              {
                "var": "entry.data.action_type"
              }
            ]
          }
        },
        {
          "id": "is_permanent_unchanged",
          "description": "Remains an instant.",
          "assert": {
            "==": [
              {
                "!!": {
                  "var": "proposal.data.is_permanent"
                }
              },
              {
                "!!": {
                  "var": "entry.data.is_permanent"
                }
              }
            ]
          }
        },
        {
          "id": "point_buy_stat_valid",
          "description": "point_buy_stat is null, 'any' or one of the four stats.",
          "assert": {
            "or": [
              {
                "==": [
                  {
                    "var": "proposal.data.point_buy_stat"
                  },
                  null
                ]
              },
              {
                "in": [
                  {
                    "var": "proposal.data.point_buy_stat"
                  },
                  [
                    "any",
                    "stat_vitality",
                    "stat_world",
                    "stat_matter",
                    "stat_will",
                    "vitality",
                    "world",
                    "matter",
                    "will"
                  ]
                ]
              }
            ]
          }
        }
      ],
      "references": [
        "action_can_cast_non_instant",
        "is_enemy",
        "rule_8_instant_returns"
      ]
    }
  }
