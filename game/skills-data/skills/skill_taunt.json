    "data": {
      "action_type": "B",
      "is_permanent": true,
      "point_buy_stat": "stat_vitality",
      "text": "Permanent. Nearby (adjacent) enemies cannot Attack anything besides you — every ally next to you is protected from their Attacks — and cannot use Block against you: their Block deals you no damage and does not stop your Attack. Weak alone, strong in a team."
    },
    "rebalance_links": [
      "skill_barricade"
    ],
    "logic": {
      "description": "Permanent skill played with a Block card; placed with a point-buy die of Vitality. While held (user ruling 2026-11-16): ALL nearby enemies (in contact with the taunter) cannot Attack anything besides the taunter — their Attack on anyone else deals 0, so every ally next to the taunter is protected — and cannot use Block against the taunter: their Block deals the taunter no damage and the taunter's Attack lands on them as against an Empty action (1). Weak alone, strong in a team. Destroyable under Rule 24 by a die >= its power.",
      "prerequisites": [
        {
          "id": "rides_on_block",
          "description": "The caster's action this turn is a Block card.",
          "when": {
            "in": [
              {
                "var": "caster.action"
              },
              [
                "B"
              ]
            ]
          }
        },
        {
          "id": "not_already_held",
          "description": "The permanent is not already in the caster's holding.",
          "when": {
            "!": {
              "includes": [
                {
                  "var": "caster.permanents"
                },
                "skill_taunt"
              ]
            }
          }
        }
      ],
      "effects": [
        {
          "id": "placement_dice",
          "description": "Number of d6 the placement point-buy rolls against Vitality.",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "point_buy_dice_count",
              {
                "stat": {
                  "var": "caster.stats.vitality"
                }
              }
            ]
          }
        },
        {
          "id": "enemy_attack_on_others_damage",
          "description": "Damage an enemy in contact with the taunter deals to a third unit with Attack: always 0 (null when the taunt does not apply).",
          "target": "all_enemies",
          "unit": "damage",
          "value": {
            "if": [
              {
                "and": [
                  {
                    "rule": [
                      "in_contact",
                      {
                        "dist": {
                          "var": "dist"
                        }
                      }
                    ]
                  },
                  {
                    "rule": [
                      "is_enemy",
                      {
                        "a_alliance": {
                          "var": "caster.alliance"
                        },
                        "b_alliance": {
                          "var": "target.alliance"
                        }
                      }
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "target.action"
                      },
                      "A"
                    ]
                  }
                ]
              },
              0,
              null
            ]
          }
        },
        {
          "id": "enemy_block_on_taunter",
          "description": "Damage a nearby enemy's Block deals the taunter: always 0 (null when the taunt does not apply). The taunter's Attack on that blocker deals the matrix damage against an Empty action instead of against a Block.",
          "target": "all_enemies",
          "unit": "damage",
          "value": {
            "if": [
              {
                "and": [
                  {
                    "rule": [
                      "in_contact",
                      {
                        "dist": {
                          "var": "dist"
                        }
                      }
                    ]
                  },
                  {
                    "rule": [
                      "is_enemy",
                      {
                        "a_alliance": {
                          "var": "caster.alliance"
                        },
                        "b_alliance": {
                          "var": "target.alliance"
                        }
                      }
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "target.action"
                      },
                      "B"
                    ]
                  }
                ]
              },
              0,
              null
            ]
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "A Rule 24 point-buy die destroys the permanent when it reaches the placement power.",
          "target": "caster",
          "unit": "tokens",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "var": "caster.perm_power.skill_taunt"
                }
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "action_type_unchanged",
          "description": "Stays a Block skill.",
          "assert": {
            "==": [
              {
                "var": "proposal.data.action_type"
              },
              {
                "var": "entry.data.action_type"
              }
            ]
          }
        },
        {
          "id": "stays_permanent",
          "description": "Remains a permanent.",
          "assert": {
            "==": [
              {
                "!!": {
                  "var": "proposal.data.is_permanent"
                }
              },
              {
                "!!": {
                  "var": "entry.data.is_permanent"
                }
              }
            ]
          }
        },
        {
          "id": "point_buy_stat_valid",
          "description": "A permanent needs a point-buy stat: 'any' or one of the four stats.",
          "assert": {
            "in": [
              {
                "var": "proposal.data.point_buy_stat"
              },
              [
                "any",
                "stat_vitality",
                "stat_world",
                "stat_matter",
                "stat_will",
                "vitality",
                "world",
                "matter",
                "will"
              ]
            ]
          }
        }
      ],
      "references": [
        "in_contact",
        "is_enemy",
        "point_buy_dice_count",
        "using_rule_24"
      ]
    }
  }
}
