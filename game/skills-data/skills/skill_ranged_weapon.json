    "data": {
      "action_type": "A",
      "is_permanent": true,
      "point_buy_stat": "stat_matter",
      "element": "elem_fire",
      "text": "Permanent. +1 range: your Attack action is opposed to an enemy's action from 2 hexes away; there the enemy's Block deals you no combat damage and a Move or Posture with no contact does nothing to you. Against an adjacent enemy it gives no bonus: your Attack resolves as a plain Attack (a nearby Block deals you its regular 1 damage). Your Attack action does not trigger traps and the follow rule is not applied."
    },
    "rebalance_links": [
      "skill_disruption_move"
    ],
    "logic": {
      "description": "Permanent skill played with an Attack card; lands in the permanents holding with a point-buy die of Matter (dice_count(matter) d6, highest die = power). While held (user rulings 2026-11-16): +1 range — the holder's Attack is opposed to an enemy's action from 2 hexes away (skills.mjs attack_range); at that range the enemy's Block deals the holder no combat damage and a Move or Posture with no contact does nothing. Against an ADJACENT enemy it gives no bonus: the Attack resolves as a plain Attack and a Block deals its regular 1 damage. The holder's Attack ignores traps and the follow rule (Rule 15). Destroyable under Rule 24 by a die >= its power. Not playable while already held.",
      "prerequisites": [
        {
          "id": "rides_on_attack",
          "description": "The caster's action this turn is an Attack card.",
          "when": {
            "in": [
              {
                "var": "caster.action"
              },
              [
                "A"
              ]
            ]
          }
        },
        {
          "id": "not_already_held",
          "description": "The permanent is not already in the caster's holding.",
          "when": {
            "!": {
              "includes": [
                {
                  "var": "caster.permanents"
                },
                "skill_ranged_weapon"
              ]
            }
          }
        }
      ],
      "effects": [
        {
          "id": "placement_dice",
          "description": "Number of d6 the placement point-buy rolls against Matter.",
          "target": "caster",
          "unit": "die",
          "value": {
            "rule": [
              "point_buy_dice_count",
              {
                "stat": {
                  "var": "caster.stats.matter"
                }
              }
            ]
          }
        },
        {
          "id": "attack_reach",
          "description": "Hexes the holder's strike reaches: 2 for an Attack (+1 range), 1 for anything else.",
          "target": "caster",
          "unit": "hexes",
          "value": {
            "if": [
              {
                "==": [
                  {
                    "var": "caster.action"
                  },
                  "A"
                ]
              },
              2,
              1
            ]
          }
        },
        {
          "id": "block_damage_prevented",
          "description": "Damage the holder does NOT take from a blocking defender: 1 when the holder Attacks into a Block from beyond contact (distance 2), else 0 (an adjacent Block hurts as usual).",
          "target": "caster",
          "unit": "damage",
          "value": {
            "if": [
              {
                "and": [
                  {
                    "==": [
                      {
                        "var": "caster.action"
                      },
                      "A"
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "defender.action"
                      },
                      "B"
                    ]
                  },
                  {
                    ">": [
                      {
                        "var": "dist"
                      },
                      1
                    ]
                  }
                ]
              },
              {
                "rule": [
                  "rps_edge",
                  {
                    "actor": "B",
                    "defender": "A"
                  }
                ]
              },
              0
            ]
          }
        },
        {
          "id": "destroyed_by_rule_24",
          "description": "A Rule 24 point-buy die destroys the permanent when it reaches the placement power.",
          "target": "caster",
          "unit": "tokens",
          "value": {
            "rule": [
              "using_rule_24",
              {
                "die": {
                  "var": "die"
                },
                "power": {
                  "var": "caster.perm_power.skill_ranged_weapon"
                }
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "action_type_unchanged",
          "description": "Stays an Attack skill.",
          "assert": {
            "==": [
              {
                "var": "proposal.data.action_type"
              },
              {
                "var": "entry.data.action_type"
              }
            ]
          }
        },
        {
          "id": "stays_permanent",
          "description": "Remains a permanent.",
          "assert": {
            "==": [
              {
                "!!": {
                  "var": "proposal.data.is_permanent"
                }
              },
              {
                "!!": {
                  "var": "entry.data.is_permanent"
                }
              }
            ]
          }
        },
        {
          "id": "point_buy_stat_valid",
          "description": "A permanent needs a point-buy stat: 'any' or one of the four stats.",
          "assert": {
            "in": [
              {
                "var": "proposal.data.point_buy_stat"
              },
              [
                "any",
                "stat_vitality",
                "stat_world",
                "stat_matter",
                "stat_will",
                "vitality",
                "world",
                "matter",
                "will"
              ]
            ]
          }
        }
      ],
      "references": [
        "point_buy_dice_count",
        "rps_edge",
        "using_rule_24"
      ]
    }
  }
}
