    "logic": {
      "description": "Instant riding on an Attack card. If the Attack lands (resolution-matrix damage >= 1 against the defender) it deals +1 damage; a blocked or neutralised Attack gains nothing. Paper lock implemented (user ruling 2026-11-16): once it paid off (its card did not return to hand under Rule 8) the caster cannot perform any other action except Attack until the end of the round — any other action it plans is played as a bare Empty Posture (no card, no skill, no cast). game/skills.mjs plan_lock; applied at planning by peer.mjs. No-benefit casts return to hand under Rule 8 (pc override) and lock nothing.",
      "prerequisites": [
        {
          "id": "rides_on_attack",
          "description": "The caster's action this turn is an Attack card.",
          "when": {
            "in": [
              {
                "var": "caster.action"
              },
              [
                "A"
              ]
            ]
          }
        },
        {
          "id": "enemy_in_contact",
          "description": "The right-clicked target is an enemy in contact (distance <= 1).",
          "when": {
            "and": [
              {
                "rule": [
                  "in_contact",
                  {
                    "dist": {
                      "var": "dist"
                    }
                  }
                ]
              },
              {
                "rule": [
                  "is_enemy",
                  {
                    "a_alliance": {
                      "var": "caster.alliance"
                    },
                    "b_alliance": {
                      "var": "target.alliance"
                    }
                  }
                ]
              }
            ]
          }
        }
      ],
      "effects": [
        {
          "id": "bonus_damage",
          "description": "+1 damage when the Attack's matrix damage against the defender is at least 1, else 0.",
          "target": "target",
          "unit": "damage",
          "value": {
            "if": [
              {
                ">=": [
                  {
                    "rule": [
                      "rps_edge",
                      {
                        "actor": {
                          "var": "caster.action"
                        },
                        "defender": {
                          "var": "defender.action"
                        }
                      }
                    ]
                  },
                  1
                ]
              },
              1,
              0
            ]
          }
        },
        {
          "id": "total_attack_damage",
          "description": "Matrix damage of the Attack plus the Powerful Attack bonus.",
          "target": "target",
          "unit": "damage",
          "value": {
            "+": [
              {
                "rule": [
                  "rps_edge",
                  {
                    "actor": {
                      "var": "caster.action"
                    },
                    "defender": {
                      "var": "defender.action"
                    }
                  }
                ]
              },
              {
                "if": [
                  {
                    ">=": [
                      {
                        "rule": [
                          "rps_edge",
                          {
                            "actor": {
                              "var": "caster.action"
                            },
                            "defender": {
                              "var": "defender.action"
                            }
                          }
                        ]
                      },
                      1
                    ]
                  },
                  1,
                  0
                ]
              }
            ]
          }
        },
        {
          "id": "attack_only_rest_of_round",
          "description": "1 when the rest of the round is locked to Attack: the Attack landed (matrix damage >= 1), so the card stays played; any other planned action becomes a bare Empty Posture.",
          "target": "caster",
          "unit": "actions",
          "value": {
            "if": [
              {
                ">=": [
                  {
                    "rule": [
                      "rps_edge",
                      {
                        "actor": {
                          "var": "caster.action"
                        },
                        "defender": {
                          "var": "defender.action"
                        }
                      }
                    ]
                  },
                  1
                ]
              },
              1,
              0
            ]
          }
        },
        {
          "id": "rule_8_return_to_hand",
          "description": "Rule 8 pc override: the card returns to hand when the round gave no benefit.",
          "target": "caster",
          "unit": "cards",
          "value": {
            "rule": [
              "rule_8_instant_returns",
              {
                "took_with": {
                  "var": "outcome.took_with"
                },
                "took_without": {
                  "var": "outcome.took_without"
                },
                "dealt_with": {
                  "var": "outcome.dealt_with"
                },
                "dealt_without": {
                  "var": "outcome.dealt_without"
                }
              }
            ]
          }
        }
      ],
      "validation": [
        {
          "id": "action_type_unchanged",
          "description": "Stays an Attack skill.",
          "assert": {
            "==": [
              {
                "var": "proposal.data.action_type"
              },
              {
                "var": "entry.data.action_type"
              }
            ]
          }
        },
        {
          "id": "is_permanent_unchanged",
          "description": "Remains an instant (non-permanent).",
          "assert": {
            "==": [
              {
                "!!": {
                  "var": "proposal.data.is_permanent"
                }
              },
              {
                "!!": {
                  "var": "entry.data.is_permanent"
                }
              }
            ]
          }
        },
        {
          "id": "point_buy_stat_valid",
          "description": "point_buy_stat is null, 'any' or one of the four stats.",
          "assert": {
            "or": [
              {
                "==": [
                  {
                    "var": "proposal.data.point_buy_stat"
                  },
                  null
                ]
              },
              {
                "in": [
                  {
                    "var": "proposal.data.point_buy_stat"
                  },
                  [
                    "any",
                    "stat_vitality",
                    "stat_world",
                    "stat_matter",
                    "stat_will",
                    "vitality",
                    "world",
                    "matter",
                    "will"
                  ]
                ]
              }
            ]
          }
        }
