  "card": {"name":"Battle trance","tags":["posture","economy"],"resources":{"source":"warlords3_battlecry","match_reason":"buff marker + heartbeat","confidence":"medium","wbc3_name":"Yellow ring with + sign (buff marker)","wbc3_code":"EZ68","wbc3_race":"Effects1","sprites":{"effect":{"path":"assets/Sprites/Effects/Effects1/Yellow ring with + sign (buff marker)/Yellow ring with + sign (buff marker) - idle [EZ68].png","usage":"marker/animation strip shown on the skill target hex (cols = frames)"}},"sounds":{"fx":[{"path":"assets/Sounds/SoundFX/HeartBeatFast.wav","usage":"play when the skill resolves (pick randomly if several)"}]}},"data":{"action_type":"P","is_permanent":false,"point_buy_stat":null,"text":"You may use another action this turn; choose both or one for the calculations."},"rebalance_links":["effect_haste"],"logic":{"description":"Trance instant: rides on ANY real action card ('*' in the pc game, Posture on paper) and lets the caster play a second action card this turn. Per adjacent enemy the resolver picks the option (first, second, or both) that benefits the trance actor most (dealt minus taken); each Attack option hits at most one enemy, the declared target chooses first; with nobody adjacent both options are played. A countered trance collapses to its first card. Rule 8 pc override: returns to hand when the second option never improved the maths.","prerequisites":[{"id":"rides_on_real_action","description":"The caster plays a real action card (A/B/M/P), not an empty action.","when":{"in":[{"var":"caster.action"},["A","B","M","P"]]}},{"id":"two_action_options","description":"Two action codes are queued (the trance pair), both battle codes.","when":{"and":[{"==":[{"count":[{"var":"caster.trance_options"}]},2]},{"subset_of":[{"var":"caster.trance_options"},{"rule":["valid_action_codes",{}]}]}]}}],"effects":[{"id":"actions_this_turn","description":"The caster resolves with two action options this turn.","target":"caster","unit":"actions","value":{"count":[{"var":"caster.trance_options"}]}},{"id":"best_damage_vs_defender","description":"Against one defender the trance scores the better of its two options' matrix damage.","target":"target","unit":"damage","value":{"max":[{"rule":["rps_edge",{"actor":{"var":"caster.trance_options.0"},"defender":{"var":"defender.action"}}]},{"rule":["rps_edge",{"actor":{"var":"caster.trance_options.1"},"defender":{"var":"defender.action"}}]}]}},{"id":"rule_8_return_to_hand","description":"Rule 8 pc override: the card returns to hand when the round gave no benefit.","target":"caster","unit":"cards","value":{"rule":["rule_8_instant_returns",{"took_with":{"var":"outcome.took_with"},"took_without":{"var":"outcome.took_without"},"dealt_with":{"var":"outcome.dealt_with"},"dealt_without":{"var":"outcome.dealt_without"}}]}}],"validation":[{"id":"action_type_in_family","description":"Stays a Posture-family / any-action trance skill.","assert":{"in":[{"var":"proposal.data.action_type"},["P","*"]]}},{"id":"is_permanent_unchanged","description":"Remains an instant.","assert":{"==":[{"!!":{"var":"proposal.data.is_permanent"}},{"!!":{"var":"entry.data.is_permanent"}}]}},{"id":"point_buy_stat_valid","description":"point_buy_stat is null, 'any' or one of the four stats.","assert":{"or":[{"==":[{"var":"proposal.data.point_buy_stat"},null]},{"in":[{"var":"proposal.data.point_buy_stat"},["any","stat_vitality","stat_world","stat_matter","stat_will","vitality","world","matter","will"]]}]}}],"references":["rps_edge","rule_8_instant_returns","valid_action_codes"]}}
