{
  "schema": "chaosd6.skill-lib/1",
  "id": "skills_pass",
  "version": "1.1.0",
  "description": "MV 2026-11-17: subroutines of the pass-hook programs (counter_pre, negate_action, negate_kind, trance_assign) — the skills.mjs helpers (ridesFor, nonPerm, adjacentFoes, foeFor, negate, counterSkills, Counter Spell bestElem) as edit-record builders. Self-contained (no skills_std calls).",
  "subs": {
    "ps_rides": {"params": ["rv","req"], "doc": "skills.mjs ridesFor(r)(req): codes = r.trance (JS truthy) or [r.action]; own code, or M / P on EP / EM", "body": {"let":[{"codes":{"if":[{"bool":[{"var":"rv.trance"}]},{"var":"rv.trance"},[{"var":"rv.action"}]]}},{"or":[{"in":[{"var":"req"},{"var":"codes"}]},{"and":[{"or":[{"===":[{"var":"req"},"M"]},{"===":[{"var":"req"},"P"]}]},{"or":[{"in":["EP",{"var":"codes"}]},{"in":["EM",{"var":"codes"}]}]}]}]}]}},
    "ps_skills_of": {"params": ["id"], "doc": "the live skills list of id's reveal (or [])", "body": {"or":[{"get":[{"reveal_of":[{"var":"id"}]},"skills"]},[]]}},
    "ps_non_perm": {"params": ["id"], "doc": "helpers#nonPerm: not the trance skill (flags.trance — Battle Trance) and not a permanent skill", "body": {"and":[{"!":[{"skill_flag":[{"var":"id"},"trance"]}]},{"!":[{"bool":[{"get":[{"skill_data":[{"var":"id"}]},"is_permanent"]}]}]}]}},
    "ps_adjacent_foes": {"params": ["id"], "doc": "helpers#adjacentFoes: revealers ≠ id, enemy, not hidden from id, within 1", "body": {"map":[{"filter":[{"reveals":[]},{"and":[{"!==":[{"var":"o.actor"},{"var":"id"}]},{"enemy_of":[{"var":"id"},{"var":"o.actor"}]},{"!":[{"hidden_from":[{"var":"id"},{"var":"o.actor"}]}]},{"<=":[{"dist":[{"var":"id"},{"var":"o.actor"}]},1]}]},"o"]},{"var":"o.actor"},"o"]}},
    "ps_foe_for": {"params": ["rv"], "doc": "helpers#foeFor: the right-clicked character if in effAction and visible, else the adjacent foe — attackers first, then id", "body": {"let":[{"t":{"if":[{"===":[{"var":"rv.target.kind"},"character"]},{"var":"rv.target.ref"},null]}},{"if":[{"and":[{"bool":[{"var":"t"}]},{"eff_has":[{"var":"t"}]},{"!":[{"hidden_from":[{"var":"rv.actor"},{"var":"t"}]}]}]},{"var":"t"},{"or":[{"at":[{"sort_by":[{"call":["ps_adjacent_foes",{"var":"rv.actor"}]},{"desc":{"if":[{"code_is":[{"var":"f"},"A"]},1,0]}},{"locale":{"var":"f"}},"f"]},0]},null]}]}]}},
    "ps_negate": {"params": ["by","sk","oid","what"], "doc": "helpers#negate: o's riding instants back with the action — records [skills, fx{negated, ridden}]", "body": {"let":[{"cur":{"or":[{"get":[{"reveal_of":[{"var":"oid"}]},"skills"]},[]]}},[{"obj":{"op":"skills","id":{"var":"oid"},"skills":{"filter":[{"var":"cur"},{"!":[{"call":["ps_non_perm",{"var":"x"}]}]},"x"]}}},{"obj":{"op":"fx","fx":{"obj":{"by":{"var":"by"},"skill":{"var":"sk"},"on":{"var":"oid"},"what":{"var":"what"},"negated":true,"ridden":{"filter":[{"var":"cur"},{"call":["ps_non_perm",{"var":"x"}]},"x"]},"building":{"from_building":[{"var":"by"},{"var":"sk"}]}}}}}]]}},
    "ps_counter": {"params": ["by","sk","oid"], "doc": "helpers#counterSkills: o's non-permanent skills countered — records [skills, fx{what: skills, countered}]", "body": {"let":[{"cur":{"or":[{"get":[{"reveal_of":[{"var":"oid"}]},"skills"]},[]]}},[{"obj":{"op":"skills","id":{"var":"oid"},"skills":{"filter":[{"var":"cur"},{"!":[{"call":["ps_non_perm",{"var":"x"}]}]},"x"]}}},{"obj":{"op":"fx","fx":{"obj":{"by":{"var":"by"},"skill":{"var":"sk"},"on":{"var":"oid"},"what":"skills","countered":{"filter":[{"var":"cur"},{"call":["ps_non_perm",{"var":"x"}]},"x"]},"building":{"from_building":[{"var":"by"},{"var":"sk"}]}}}}}]]}},
    "ps_counter_best": {"params": ["o","me"], "doc": "counterPre#bestElem: of the element types in o's cast (sorted), the one whose penalty (MY stat) saves me the most; null when o casts no damage", "body": {"if":[{"!":[{"casts_damage":[{"var":"o"}]}]},null,{"let":[{"before":{"effect_dmg":[{"var":"o"},{"var":"me"}]},"cv":{"view":[{"var":"me"}]}},{"reduce":[{"sort":[{"uniq":[{"var":"o.effect.elements"}]}]},{"let":[{"el":{"var":"current"},"amount":{"max":[0,{"??":[{"get":[{"var":"cv"},{"cat":["stat_",{"elem_stat":[{"var":"current"}]}]}]},0]}]}},{"if":[{"!":[{"bool":[{"var":"amount"}]}]},{"var":"acc"},{"let":[{"saved":{"-":[{"var":"before"},{"effect_dmg_pen":[{"var":"o"},{"var":"me"},{"var":"el"},{"var":"amount"}]}]}},{"if":[{"or":[{"is_null":[{"var":"acc"}]},{">":[{"var":"saved"},{"var":"acc.saved"}]}]},{"obj":{"el":{"var":"el"},"amount":{"var":"amount"},"saved":{"var":"saved"}}},{"var":"acc"}]}]}]}]},null]}]}]}}
  }
}
