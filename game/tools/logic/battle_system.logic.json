{
  "collection": "battle_system",
  "entries": {
    "battle_system_core": {
      "description": "The core combat contract. A pc character plays 3 actions per round (monsters 1..4), all declared face down and flipped simultaneously; declaration order is Empty Move announce, action flip, effects, then skills / instants / class abilities / point-buys. Combat damage comes off the 4-cycle resolution matrix (Attack > Posture > Move > Block > Attack, 1 per edge, Attack base 1; empty actions are read as the action they lose to). Effect damage is Rule 21: sum over the cast's elements of max0(caster stat - defender stat), / 10, rounded half up (0.5 -> 1). Life is the stat sum / 10 rounded half up. Move walks 1 hex, Empty Move half the distance rounded up. End of round: discard, refill to 5 (monsters do not discard).",
      "prerequisites": [
        { "id": "has_actions_left", "description": "The unit still has an action this round (action_index below its actions per round).", "when": { "<": [{ "var": "action_index" }, { "max": [1, { "var": "caster.actions_per_round" }] }] } },
        { "id": "round_in_range", "description": "The round counter runs 0..2 within a turn.", "when": { "and": [{ ">=": [{ "var": "round" }, 0] }, { "<": [{ "var": "round" }, { "entry": ["battle_system_core", "turn_structure.actions_per_round_pc"] }] }] } }
      ],
      "effects": [
        { "id": "actions_per_round_pc", "description": "A pc character declares 3 actions per round.", "target": "caster", "unit": "actions", "value": { "entry": ["battle_system_core", "turn_structure.actions_per_round_pc"] } },
        { "id": "monster_actions_in_range", "description": "A monster's actions per round lie within the configured 1..4 range.", "target": "caster", "unit": "actions", "value": { "and": [{ ">=": [{ "var": "caster.actions_per_round" }, { "entry": ["battle_system_core", "turn_structure.actions_per_round_monster_range.0"] }] }, { "<=": [{ "var": "caster.actions_per_round" }, { "entry": ["battle_system_core", "turn_structure.actions_per_round_monster_range.1"] }] }] } },
        { "id": "combat_damage", "description": "Resolution-matrix damage of the caster's action against the defender's (Attack base 1 + one edge).", "target": "target", "unit": "damage", "value": { "rule": ["rps_edge", { "actor": { "var": "caster.action" }, "defender": { "var": "defender.action" } }] } },
        { "id": "edge_list", "description": "The configured matrix edges (actor, defender, bonus_damage_to_actor).", "target": "everyone", "unit": "damage", "value": { "entry": ["battle_system_core", "resolution_matrix.edges"] } },
        { "id": "effect_damage", "description": "Rule 21 delta damage of the cast's elements, caster vs defender.", "target": "target", "unit": "damage", "value": { "rule": ["rule_21_delta_damage", { "caster": { "root": "caster" }, "defender": { "root": "defender" }, "elements": { "root": "elements" } }] } },
        { "id": "life_from_stats", "description": "A unit's life is round_half_up(stat sum / 10).", "target": "caster", "unit": "life", "value": { "rule": ["life_from_stats", { "stats": { "var": "caster.stats" } }] } },
        { "id": "rounding_half_up_check", "description": "Rounding contract: 5/10 rounds to 1 and 4/10 to 0.", "target": "everyone", "unit": "damage", "value": { "and": [{ "==": [{ "round_div10": [5] }, 1] }, { "==": [{ "round_div10": [4] }, 0] }, { "==": [{ "round_half_up": [0.5] }, 1] }] } },
        { "id": "point_buy_dice", "description": "Point-buy dice for the caster's stat behind the first cast element.", "target": "caster", "unit": "die", "value": { "rule": ["point_buy_dice_count", { "stat": { "stat_of": [{ "var": "caster" }, { "var": "elements.0" }] } }] } },
        { "id": "move_hexes", "description": "Move walks move_action_distance_tiles (1); Empty Move ceil(dist * empty_move_distance_tiles).", "target": "caster", "unit": "hexes", "value": { "if": [{ "==": [{ "var": "caster.action" }, "EM"] }, { "max": [1, { "ceil": [{ "*": [{ "var": "dist" }, { "entry": ["battle_system_core", "movement_and_range.empty_move_distance_tiles"] }] }] }] }, { "==": [{ "var": "caster.action" }, "M"] }, { "entry": ["battle_system_core", "movement_and_range.move_action_distance_tiles"] }, 0] } },
        { "id": "end_of_round_draw", "description": "Cards drawn at end of round to refill the hand to 5.", "target": "caster", "unit": "cards", "value": { "rule": ["hand_refill", { "hand_size": { "var": "caster.hand_size" } }] } }
      ],
      "validation": [
        { "id": "actions_per_round_pc_is_3", "description": "actions_per_round_pc stays 3.", "assert": { "==": [{ "var": "proposal.data.turn_structure.actions_per_round_pc" }, 3] } },
        { "id": "monster_range_1_to_4", "description": "Monster actions per round stay in the 1..4 range.", "assert": { "and": [{ "==": [{ "var": "proposal.data.turn_structure.actions_per_round_monster_range.0" }, 1] }, { "==": [{ "var": "proposal.data.turn_structure.actions_per_round_monster_range.1" }, 4] }] } },
        { "id": "edges_keep_the_4_cycle", "description": "The edge list contains A>P, P>M, M>B and B>A, each with bonus 1 to the actor.", "assert": { "and": [
          { "some": [{ "var": "proposal.data.resolution_matrix.edges" }, { "and": [{ "==": [{ "var": "actor" }, "A"] }, { "==": [{ "var": "defender" }, "P"] }, { "==": [{ "var": "bonus_damage_to_actor" }, 1] }] }] },
          { "some": [{ "var": "proposal.data.resolution_matrix.edges" }, { "and": [{ "==": [{ "var": "actor" }, "P"] }, { "==": [{ "var": "defender" }, "M"] }, { "==": [{ "var": "bonus_damage_to_actor" }, 1] }] }] },
          { "some": [{ "var": "proposal.data.resolution_matrix.edges" }, { "and": [{ "==": [{ "var": "actor" }, "M"] }, { "==": [{ "var": "defender" }, "B"] }, { "==": [{ "var": "bonus_damage_to_actor" }, 1] }] }] },
          { "some": [{ "var": "proposal.data.resolution_matrix.edges" }, { "and": [{ "==": [{ "var": "actor" }, "B"] }, { "==": [{ "var": "defender" }, "A"] }, { "==": [{ "var": "bonus_damage_to_actor" }, 1] }] }] }
        ] } },
        { "id": "edges_use_battle_codes", "description": "Every edge names battle action codes only.", "assert": { "all": [{ "var": "proposal.data.resolution_matrix.edges" }, { "and": [{ "in": [{ "var": "actor" }, { "rule": ["valid_action_codes", {}] }] }, { "in": [{ "var": "defender" }, { "rule": ["valid_action_codes", {}] }] }] }] } },
        { "id": "movement_distances", "description": "Move stays 1 tile and Empty Move half a tile.", "assert": { "and": [{ "==": [{ "var": "proposal.data.movement_and_range.move_action_distance_tiles" }, 1] }, { "==": [{ "var": "proposal.data.movement_and_range.empty_move_distance_tiles" }, 0.5] }] } }
      ]
    }
  }
}
