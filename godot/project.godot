; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="chaosD6 Dimensions"
config/description="Isometric hex RPG client for chaosD6 Dimensions using the curated Warlords Battlecry III assets."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

RadicleBoot="*res://scripts/RadicleBoot.gd"
AssetBootstrap="*res://scripts/AssetBootstrap.gd"
DimensionLauncher="*res://scripts/DimensionLauncher.gd"
EmbeddedPeer="*res://scripts/EmbeddedPeer.gd"
MobileHudWebView="*res://scripts/MobileHudWebView.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor_landscape"

