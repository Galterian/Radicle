# Fetched by _tools/fetch_nodejs_mobile.sh — not committed (large; 40 MB per ABI).
src/main/jniLibs/
src/main/cpp/node-headers/

# Staged by _tools/stage_peer_js.sh — generated from game/, not committed.
# nodejs-project/ is the correct location; the extra path below guards against
# a staging-script regression that could leak files alongside it.
src/main/assets/nodejs-project/
src/main/assets/data/

# Built AAR + gradle output (regenerated by `./gradlew :assembleRelease`).
build/
nodejs_mobile.aar

# Gradle daemon's per-project cache. Regenerated on first build.
.gradle/

# Supplied by export-template install, same as radicle_node/libs/.
# Contains godot-lib.release.aar from the Godot editor's Android template.
libs/
